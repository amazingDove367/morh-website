# 값이 없는 예시 파일입니다. 복사해 .env 로 저장한 뒤 값을 채우세요(.env 는 Git 에 올리지 않음).

# 운영 주소(예: https://example.com). 있으면 canonical·hreflang·sitemap 을 만듭니다.
PUBLIC_SITE_URL=

# 검색 노출 허용. 운영 배포에서만 true. 비어 있거나 false 면 모든 페이지 noindex + robots.txt 전체 차단
PUBLIC_INDEXABLE=false

# GA4 측정 ID. 운영 배포(.github/workflows/deploy.yml)에는 G-D3ENJ9B8P7 이 들어가 있음.
# 로컬에서는 비워 두면 분석 스크립트를 넣지 않음(내 방문이 통계에 섞이지 않게). 로컬 확인이 필요할 때만 입력
PUBLIC_GA4_ID=
# Google 태그 관리자 컨테이너 ID. 운영 배포에는 GTM-5DQWMNL6 이 들어가 있음. 로컬은 비워 둠
PUBLIC_GTM_ID=
# Meta 픽셀 ID. 운영 배포에는 1405548278234602 가 들어가 있음. 로컬은 비워 둠
PUBLIC_META_PIXEL_ID=

# 하위 경로에 배포할 때의 기준 경로(예: GitHub Pages 프로젝트 사이트는 /morh-website/). 기본 /
BASE_PATH=/
