---
const path = Astro.url.pathname;
const isProduct = path.includes('/product');
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="MORH 모르 홈">MORH</a>
    <nav class="site-nav" aria-label="주요 메뉴">
      <a href="/prototype/story/">Brand</a>
      <a href="/prototype/product-a/" aria-current={isProduct ? 'page' : undefined}>Product</a>
      <a href="/prototype/product-a/#reviews">Review</a>
    </nav>
    <a class="site-header__cta" href="/prototype/product-a/">제품 보기</a>
  </div>
</header>
