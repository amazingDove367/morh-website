---
/*
  상세페이지 오른쪽 정보 패널 (레퍼런스 '텍스쳐.png'의 얇은 사각 테두리 패널)
  EXPLORE MORH → 제품명 → 가격·수량·총액 → 구매하기 → THE PRODUCT / THE TEXTURE / THE RITUAL 아코디언
  - 구매 정보와 버튼을 아코디언 위에 두어, 아코디언(특히 THE TEXTURE)을 열고 닫아도 같은 위치에 유지
  - THE TEXTURE 가 텍스처 탐색의 유일한 진입점: 열면 morh:texture {open:true} 이벤트로 왼쪽 사진이 크림 제형으로 바뀜
  - 기존 구매 훅 유지: #cta-main, [data-buy-open], [data-qty], [data-total], [data-privacy-open]
*/
import { product, copy, formatKRW } from '../../data/product';
import { summarize, type Review } from '../../data/reviews';
interface Props { reviews: Review[] }
const sum = summarize(Astro.props.reviews);
---
<section class="pp" aria-labelledby="product-title" data-buy-panel>
  <a class="pp__row pp__explore" href="/#ritual">EXPLORE MORH <span aria-hidden="true">→</span></a>

  <div class="pp__row pp__head">
    <p class="pp__eyebrow">MORH · {product.category}</p>
    <h1 id="product-title" class="pp__title">{product.name}</h1>
    <p class="pp__tagline">A moment for your daily ritual.</p>
    {sum.count > 0 && (
      <a class="pp__rating" href="#reviews" data-tab-link="reviews">
        <span class="pp__stars" aria-hidden="true">★</span> {sum.average.toFixed(1)}
        <span class="muted">· 후기 {sum.count}건</span>
        {sum.sample && <span class="test-tag test-tag--sample"></span>}
      </a>
    )}
  </div>

  <div class="pp__row pp__split">
    <p class="pp__price">
      <span class="visually-hidden">판매가</span>
      <strong data-unit-price={product.price.value}>{formatKRW(product.price.value)}</strong>
      <span class="test-tag test-tag--sample"></span>
    </p>
    <div class="qty" role="group" aria-label="수량">
      <button type="button" class="qty__btn" data-qty="-1" aria-label="수량 줄이기">−</button>
      <output class="qty__val" data-qty-value aria-live="polite">1</output>
      <button type="button" class="qty__btn" data-qty="1" aria-label="수량 늘리기">+</button>
    </div>
  </div>
  <div class="pp__row pp__split pp__total buy__total">
    <span>총 상품금액</span>
    <strong data-total>{formatKRW(product.price.value)}</strong>
  </div>
  <div class="pp__cta">
    <button type="button" class="pp__buy" id="cta-main" data-buy-open>구매하기 <span aria-hidden="true">→</span></button>
  </div>

  <div class="pp__acc" data-acc>
    <h2 class="pp__acc-h">
      <button type="button" aria-expanded="false" aria-controls="acc-product" id="acc-product-btn" data-acc-btn="product">
        THE PRODUCT <span class="pp__pm" aria-hidden="true"></span>
      </button>
    </h2>
    <div class="pp__acc-panel" id="acc-product" role="region" aria-labelledby="acc-product-btn" hidden>
      <p>{copy.tagline} {copy.support} <span class="test-tag test-tag--plan"></span></p>
      <dl class="pp__specs">
        <div><dt>용량</dt><dd>확인 필요 <span class="test-tag test-tag--tbd"></span></dd></div>
        <div><dt>사용 단계</dt><dd>아침·저녁 스킨케어 마지막 단계</dd></div>
        <div><dt>용기</dt><dd>낮은 원통형 · 아이보리 뚜껑 · 골드 경계</dd></div>
      </dl>
    </div>

    <h2 class="pp__acc-h">
      <button type="button" aria-expanded="false" aria-controls="acc-texture" id="acc-texture-btn" data-acc-btn="texture">
        THE TEXTURE <span class="pp__pm" aria-hidden="true"></span>
      </button>
    </h2>
    <div class="pp__acc-panel" id="acc-texture" role="region" aria-labelledby="acc-texture-btn" hidden>
      <p>Explore the texture. 왼쪽 크림 사진을 확대해 결을 살펴보세요.</p>
    </div>

    <h2 class="pp__acc-h">
      <button type="button" aria-expanded="false" aria-controls="acc-ritual" id="acc-ritual-btn" data-acc-btn="ritual">
        THE RITUAL <span class="pp__pm" aria-hidden="true"></span>
      </button>
    </h2>
    <div class="pp__acc-panel" id="acc-ritual" role="region" aria-labelledby="acc-ritual-btn" hidden>
      <ol role="list" class="pp__steps">
        <li>세안 후 토너로 피부 결을 정돈합니다.</li>
        <li>스킨케어 마지막 단계에 적당량을 펴 바릅니다.</li>
        <li>아침에는 선크림으로 마무리합니다.</li>
      </ol>
    </div>
  </div>

  <p class="pp__demo buy__demo">데모 결제 · 실제 결제·배송은 진행되지 않습니다. <button type="button" class="linklike" data-privacy-open>개인정보 처리 안내</button></p>
</section>

<style>
  .pp { border: 1px solid var(--c-line-strong); background: var(--c-paper); font-size: 0.8125rem; }
  .pp__row { padding: 14px 20px; border-bottom: 1px solid var(--c-line-strong); }
  .pp__split { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); }
  .pp__explore {
    display: flex; gap: 10px; align-items: center; min-height: 44px; text-decoration: none;
    font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; color: var(--c-ink);
  }
  .pp__explore:hover { color: var(--c-burgundy); }
  .pp__head { padding-block: 18px 20px; }
  .pp__eyebrow { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.1em; color: var(--c-ink-soft); }
  .pp__title { font-size: 1.25rem; font-weight: 650; letter-spacing: 0.01em; margin-top: 6px; line-height: 1.35; }
  .pp__tagline { margin-top: 6px; color: var(--c-ink); }
  .pp__rating { display: inline-flex; gap: 6px; align-items: center; margin-top: 10px; text-decoration: none; min-height: 32px; }
  .pp__rating:hover { text-decoration: underline; }
  .pp__stars { color: var(--c-burgundy); }
  .pp__price { display: flex; align-items: center; gap: var(--s-2); }
  .pp__price strong { font-size: 1.125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .qty { display: inline-flex; align-items: center; border: 1px solid var(--c-line-strong); }
  .qty__btn { width: 40px; height: 40px; border: 0; background: none; cursor: pointer; font-size: 1.125rem; color: var(--c-ink); }
  .qty__btn:hover:not([disabled]) { color: var(--c-burgundy); }
  .qty__btn[disabled] { opacity: 0.35; cursor: not-allowed; }
  .qty__val { min-width: 2.2em; text-align: center; font-variant-numeric: tabular-nums; font-weight: 600; }
  .pp__total strong { font-size: 1rem; font-variant-numeric: tabular-nums; }
  .pp__cta { border-bottom: 1px solid var(--c-line-strong); }
  .pp__buy {
    width: 100%; min-height: 56px; display: flex; justify-content: center; align-items: center; gap: 12px;
    border: 0; background: var(--c-burgundy); color: #fff; cursor: pointer;
    font: inherit; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.08em;
    transition: background-color var(--dur-ui) var(--ease-cream);
  }
  .pp__buy:hover { background: var(--c-burgundy-deep); }
  .pp__acc-h { margin: 0; font-size: inherit; }
  .pp__acc-h button {
    width: 100%; min-height: 48px; display: flex; justify-content: space-between; align-items: center;
    padding: 0 20px; border: 0; border-bottom: 1px solid var(--c-line-strong); background: none; cursor: pointer;
    font: inherit; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; color: var(--c-ink); text-align: left;
  }
  .pp__acc-h button:hover { color: var(--c-burgundy); }
  .pp__pm { position: relative; width: 11px; height: 11px; }
  .pp__pm::before, .pp__pm::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; }
  .pp__pm::after { transform: rotate(90deg); transition: transform var(--dur-ui) var(--ease-cream); }
  [aria-expanded='true'] .pp__pm::after { transform: rotate(0); }
  .pp__acc-panel { padding: 14px 28px 18px; border-bottom: 1px solid var(--c-line-strong); color: var(--c-ink); line-height: 1.7; }
  .pp__acc-panel[hidden] { display: none; }
  .pp__specs { display: grid; gap: 6px; margin-top: 10px; }
  .pp__specs div { display: grid; grid-template-columns: 6em 1fr; gap: var(--s-3); }
  .pp__specs dt { color: var(--c-ink-soft); }
  .pp__steps { display: grid; gap: 4px; counter-reset: s; }
  .pp__steps li { counter-increment: s; display: grid; grid-template-columns: 1.6em 1fr; }
  .pp__steps li::before { content: counter(s, lower-roman); font-family: var(--f-serif); font-style: italic; color: var(--c-burgundy); }
  .pp__demo { padding: 12px 20px; font-size: 0.75rem; color: var(--c-ink-soft); }
  .linklike { background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; font-size: inherit; color: var(--c-ink); }
</style>

<script>
  const acc = document.querySelector<HTMLElement>('[data-acc]');
  if (acc) {
    const btns = [...acc.querySelectorAll<HTMLButtonElement>('[data-acc-btn]')];
    let textureOpen = false;
    const set = (target: HTMLButtonElement | null) => {
      btns.forEach((b) => {
        const on = b === target;
        b.setAttribute('aria-expanded', String(on));
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !on;
      });
      const tex = target?.dataset.accBtn === 'texture';
      if (tex !== textureOpen) {
        textureOpen = tex;
        document.dispatchEvent(new CustomEvent('morh:texture', { detail: { open: tex } }));
      }
    };
    btns.forEach((b) => b.addEventListener('click', () => set(b.getAttribute('aria-expanded') === 'true' ? null : b)));
  }
</script>
