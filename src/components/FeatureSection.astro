---
/* 전환 A/B가 도착하는 공통 다음 섹션 (홈 ③ 제품 특징 구간의 축약본) */
import { copy, features } from '../data/product';
interface Props { href?: string }
const { href = '/prototype/product-a/' } = Astro.props;
---
<section class="feat" id="features" aria-labelledby="feat-title">
  <div class="wrap">
    <p class="label">Why MORH</p>
    <h2 id="feat-title" class="feat__title">{copy.focus}</h2>
    <ol class="feat__list" role="list">
      {features.map((f, i) => (
        <li class="feat__item reveal" style={`transition-delay:${i * 90}ms`}>
          <span class="feat__no serif-i" aria-hidden="true">{['i', 'ii', 'iii'][i]}</span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
          <span class={`test-tag test-tag--${f.status}`}></span>
        </li>
      ))}
    </ol>
    <a class="btn" href={href}>{copy.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .feat { background: var(--c-cream-tex); padding-block: var(--s-9) var(--s-10); }
  .feat__title { font-size: var(--fs-h1); max-width: 14ch; margin-top: var(--s-3); }
  .feat__list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: var(--border-strong); margin: var(--s-8) 0 var(--s-7); }
  .feat__item { padding: var(--s-5) var(--s-5) var(--s-6) 0; display: grid; gap: var(--s-3); align-content: start; }
  .feat__item + .feat__item { border-left: var(--border); padding-left: var(--s-5); }
  .feat__no { font-size: 2rem; color: var(--c-burgundy); line-height: 1; }
  .feat__item h3 { font-size: var(--fs-h3); }
  .feat__item p { color: var(--c-ink-soft); max-width: 32ch; }
  .feat__item .test-tag { justify-self: start; }
  @media (max-width: 720px) {
    .feat__list { grid-template-columns: 1fr; }
    .feat__item, .feat__item + .feat__item { border-left: 0; padding: var(--s-5) 0; border-bottom: var(--border); }
  }
</style>

<script>
  import { initReveal } from '../scripts/scroll';
  initReveal();
</script>
