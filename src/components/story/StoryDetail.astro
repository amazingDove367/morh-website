<script>
  import { currentAd } from '../../scripts/ad-source';
  // 광고별 첫 화면: utm_content 로 고른 하나만 보이고 나머지는 숨김(값이 없으면 기본 elevator 그대로)
  const ad = currentAd();
  if (ad) document.querySelectorAll<HTMLElement>('[data-detail] [data-head]').forEach((el) => { el.hidden = el.dataset.head !== ad; });
  // 섹션이 화면에 들어오면 is-in(한 번만) → 내용이 떠오름
  const secs = document.querySelectorAll<HTMLElement>('[data-detail] .dt-sec');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    secs.forEach((el) => io.observe(el));
  } else secs.forEach((el) => el.classList.add('is-in'));
</script>
