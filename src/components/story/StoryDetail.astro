---
/*
  상세 설명(한국어) — 2026-11 개편. 레퍼런스: 기능성·데이터형 상세(가운데 정렬 좁은 단, 띠 강조, 원형 배지, 말풍선, POINT, 막대)
  흐름: ⓪ 광고별 첫 화면(답) → ① 첫 구매 혜택(장치) → ② 타깃 → ③ 고민 → ④ POINT 01~04(해결·증거) → ⑤ 사용법 → ⑥ 마무리 혜택
  - ⓪ 은 광고 링크의 utm_content(elevator · roblox · wanted)로 하나만 보임. 값이 없으면 elevator (src/scripts/ad-source.ts)
  - 글자·숫자·막대·표는 모두 HTML/CSS(검색·번역·수정 가능). 사진 자리는 StoryImage(파일이 없으면 빈 박스)
  - 측정: 혜택 버튼 cta_click · detail_offer / detail_final (기존 이벤트에 새 값만). #record 는 홈 버튼의 도착 위치
  - 문구는 src/i18n/ko-story.ts 의 detail, 가격·할인율은 src/data/commerce.ts
*/
import { koStory } from '../../i18n/ko-story';
import { SETS, setBase, setPct } from '../../data/commerce';
import { DICTS, fill, money } from '../../i18n';
import StoryImage from './StoryImage.astro';
import Nums from './Nums.astro';
import '../../styles/story.css';
const d = koStory.detail;
const p = DICTS.ko.product;
const max = Math.max(...d.skin.bars.map((b) => b.value));
const heads = Object.entries(d.heads) as [keyof typeof d.heads, (typeof d.heads)[keyof typeof d.heads]][];
---
<div class="dt-bleed">
<div class="dt" data-detail>
  <!-- ⓪ 광고별 첫 화면 -->
  {heads.map(([key, h]) => (
    <section class="dt-sec dt-head" data-head={key} hidden={key !== 'elevator'} aria-labelledby={`dt-head-${key}`}>
      <p class="dt-ask">{h.ask}</p>
      <h2 id={`dt-head-${key}`} class="dt-title"><Nums text={h.title[0]} /><br /><span class="dt-hl"><Nums text={h.title[1]} /></span></h2>
      <p class="dt-body"><Nums text={h.body} /></p>
      <div class="dt-head__media">
        <StoryImage name={h.image.name} alt={h.image.alt} ratio="4 / 5" sizes="(max-width: 720px) 90vw, 520px" />
        <ul role="list" class="dt-badges">
          {d.badges.map((b) => { const [k, v] = b.split('|'); return <li><span>{k}</span><b><Nums text={v} /></b></li>; })}
        </ul>
      </div>
      <p class="st-fn">*{h.footnote}</p>
    </section>
  ))}

  <!-- ① 첫 구매 혜택 -->
  <section class="dt-sec dt-offer" aria-labelledby="dt-offer-title">
    <p class="dt-pill">{d.offer.label}</p>
    <h2 id="dt-offer-title" class="dt-title dt-title--sm">{d.offer.title}</h2>
    <ul role="list" class="dt-tiers">
      {SETS.map((s) => (
        <li class:list={['dt-tier', { 'dt-tier--best': s.best }]}>
          <span class="dt-tier__name">{p.sets[s.id]}</span>
          <b class="dt-tier__pct">{fill(p.discount, { n: setPct(s) })}</b>
          <s>{money('ko', setBase(s))}</s>
          <strong>{money('ko', s.price)}</strong>
          <span class="dt-tier__tag">{p.setTags[s.id]}</span>
        </li>
      ))}
    </ul>
    <a class="btn dt-cta" href="#buy-options" data-ga="cta_click" data-ga-cta-location="detail_offer">{d.offer.cta} <span class="arrow" aria-hidden="true">→</span></a>
  </section>

  <!-- ② 타깃 -->
  <section class="dt-sec" aria-labelledby="dt-target-title">
    <p class="dt-ask">{d.target.ask}</p>
    <h2 id="dt-target-title" class="dt-title">{d.target.title[0]}<br /><span class="dt-hl">{d.target.title[1]}</span></h2>
    <ul role="list" class="dt-bubbles">
      {d.target.bubbles.map((b) => <li>{b}</li>)}
    </ul>
  </section>

  <!-- ③ 고민 -->
  <section class="dt-sec dt-dark" aria-labelledby="dt-pain-title">
    <h2 id="dt-pain-title" class="dt-title">{d.pain.title[0]}<br />{d.pain.title[1]}</h2>
    <ul role="list" class="dt-photos">
      {d.pain.photos.map((ph) => (
        <li><StoryImage name={ph.name} alt={ph.alt} ratio="1 / 1" sizes="(max-width: 720px) 30vw, 220px" /><span>{ph.label}</span></li>
      ))}
    </ul>
    <p class="dt-down" aria-hidden="true">↓</p>
    <p class="dt-turn">{d.pain.turn}</p>
  </section>

  <!-- ④ POINT 01: 검증된 성분 하나(USP 비교) -->
  <section class="dt-sec" aria-labelledby="dt-usp-title">
    <p class="dt-pill">{d.usp.point}</p>
    <h2 id="dt-usp-title" class="dt-title">{d.usp.title[0]}<br /><span class="dt-hl"><Nums text={d.usp.title[1]} /></span></h2>
    <p class="dt-body">{d.usp.body}</p>
    <div class="dt-range" role="img" aria-label={`${d.usp.rangeLabel} ${d.usp.rangeMin}~${d.usp.rangeMax}, ${d.usp.rangeMark}`}>
      <span class="dt-range__label">{d.usp.rangeLabel}</span>
      <span class="dt-range__track"><span class="dt-range__fill"></span><b class="dt-range__mark">{d.usp.rangeMark}</b></span>
      <span class="dt-range__ends"><Nums text={d.usp.rangeMin} /><Nums text={d.usp.rangeMax} /></span>
    </div>
    <div class="dt-vs">
      {d.usp.vs.map((v, i) => (
        <div class:list={['dt-vs__col', { 'dt-vs__col--us': i === 1 }]}><span>{v.head}</span><p><Nums text={v.text} /></p></div>
      ))}
    </div>
    <div class="dt-pair">
      {[d.usp.before, d.usp.after].map((ph) => (
        <figure><StoryImage name={ph.name} alt={ph.alt} ratio="4 / 5" sizes="(max-width: 720px) 45vw, 320px" /><figcaption>{ph.label}</figcaption></figure>
      ))}
    </div>
  </section>

  <!-- POINT 02: 기기 측정(14일 1) · 4주 2) — 각주 번호로 기간 구분). #skin = 홈 '14일간의 피부 변화 보기' 도착 위치 -->
  <section class="dt-sec dt-tint" id="skin" aria-labelledby="dt-skin-title">
    <p class="dt-pill">{d.skin.point}</p>
    <h2 id="dt-skin-title" class="dt-title">{d.skin.title[0]}<br /><span class="dt-hl">{d.skin.title[1]}</span></h2>
    <ul role="list" class="dt-big">
      {d.skin.big.map((b) => <li><span>{b.label}<sup>{b.fn}</sup></span><b><Nums text={b.value} /></b></li>)}
    </ul>
    <ul role="list" class="dt-bars">
      {d.skin.bars.map((b) => (
        <li>
          <span class="dt-bars__label">{b.label}<sup>{b.fn}</sup></span>
          <span class="dt-bars__track" aria-hidden="true"><span style={`width: ${((b.value / max) * 100).toFixed(1)}%`}></span></span>
          <b class="dt-bars__val"><Nums text={b.text} /></b>
        </li>
      ))}
    </ul>
    <div class="dt-pair">
      {[d.skin.before, d.skin.after].map((ph) => (
        <figure><StoryImage name={ph.name} alt={ph.alt} ratio="4 / 5" sizes="(max-width: 720px) 45vw, 320px" /><figcaption>{ph.label}</figcaption></figure>
      ))}
    </div>
    <p class="st-fn">*{d.skin.footnote}</p>
  </section>

  <!-- POINT 03: 4주 화장대 기록 (#record = 홈 '어떻게 쟀는지 보러 가기' 도착 위치) -->
  <section class="dt-sec" id="record" aria-labelledby="dt-record-title">
    <p class="dt-pill">{d.record.point}</p>
    <h2 id="dt-record-title" class="dt-title">{d.record.title[0]}<br /><span class="dt-hl">{d.record.title[1]}</span></h2>
    <p class="dt-body">{d.record.body}</p>
    <ul role="list" class="dt-cards">
      {d.record.cards.map((c) => (
        <li><span>{c.label}</span><p><s><Nums text={c.from} /></s><span aria-hidden="true">→</span><b><Nums text={c.to} /></b></p></li>
      ))}
    </ul>
    <div class="dt-pair">
      {[d.record.before, d.record.after].map((ph) => (
        <figure><StoryImage name={ph.name} alt={ph.alt} ratio="4 / 5" sizes="(max-width: 720px) 45vw, 320px" /><figcaption>{ph.label}</figcaption></figure>
      ))}
    </div>
    <table class="dt-table">
      <caption>{d.record.tableTitle}</caption>
      <thead><tr>{d.record.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{d.record.tableRows.map(([k, a, b]) => <tr><th scope="row">{k}</th><td><Nums text={a} /></td><td><Nums text={b} /></td></tr>)}</tbody>
      <tfoot><tr><th scope="row">{d.record.tableTotal[0]}</th><td><Nums text={d.record.tableTotal[1]} /></td><td class="dt-table__after"><Nums text={d.record.tableTotal[2]} /></td></tr></tfoot>
    </table>
    <p class="dt-body"><Nums text={d.record.note} /></p>
    <p class="st-fn">*{d.record.footnote}</p>
  </section>

  <!-- POINT 04: 수분 -->
  <section class="dt-sec dt-tint" aria-labelledby="dt-moist-title">
    <p class="dt-pill">{d.moist.point}</p>
    <h2 id="dt-moist-title" class="dt-title">{d.moist.title[0]}<br /><span class="dt-hl">{d.moist.title[1]}</span></h2>
    <p class="dt-body">{d.moist.body}</p>
    <div class="dt-metric"><span>{d.moist.metricLabel}</span><b><Nums text={d.moist.metric} /></b><small>{d.moist.metricNote}</small></div>
    <StoryImage name={d.moist.image.name} alt={d.moist.image.alt} ratio="4 / 5" sizes="(max-width: 720px) 90vw, 480px" class="dt-narrow" />
    <p class="st-fn">*{d.moist.footnote}</p>
  </section>

  <!-- ⑤ 사용법 -->
  <section class="dt-sec" aria-labelledby="dt-use-title">
    <h2 id="dt-use-title" class="dt-title dt-title--sm">{d.use.title[0]}</h2>
    <p class="dt-body">{d.use.title[1]}</p>
    <ol role="list" class="dt-steps">{d.use.morning.map((x, i) => <li><span><Nums text={String(i + 1)} /></span>{x}</li>)}</ol>
    <p class="dt-steps__label">{d.use.morningLabel}</p>
    <ol role="list" class="dt-timeline">{d.use.timeline.map((x) => <li><Nums text={x} /></li>)}</ol>
  </section>

  <!-- ⑥ 마무리 혜택 -->
  <section class="dt-sec dt-final" aria-labelledby="dt-final-title">
    <p class="dt-final__en" lang="en">{d.final.en}</p>
    <h2 id="dt-final-title" class="dt-title">{d.final.title}</h2>
    <a class="btn dt-cta dt-cta--light" href="#buy-options" data-ga="cta_click" data-ga-cta-location="detail_final">{d.final.cta} <span class="arrow" aria-hidden="true">→</span></a>
  </section>
</div>
</div>

<style>
  /* 가운데 정렬 좁은 단(레퍼런스와 같은 세로 흐름). 색은 MORH 팔레트: 버건디 띠·원형 배지, 할인율만 --c-sale */
  /* 상세 설명 영역을 페이지와 구분: 화면 끝까지 위에서 빛이 드는 Cream 바탕 + 가운데 흰 단
     입체감 = 겹친 그림자 3단(가까운 그림자·떨어진 그림자·바닥 그림자) */
  .dt-bleed {
    border-image: radial-gradient(120% 70% at 50% 0%, var(--c-ivory) 0%, var(--c-cream) 55%, #e2d3c4 100%) fill 0 / / 0 100vmax;
    margin-top: calc(-1 * clamp(24px, 4vw, 56px)); padding-block: clamp(32px, 5vw, 72px); margin-bottom: var(--s-7);
  }
  .dt {
    position: relative; max-width: 720px; margin-inline: auto; text-align: center; background: #fff;
    box-shadow: 0 1px 2px rgb(43 26 31 / 0.06), 0 14px 28px -10px rgb(63 1 23 / 0.16), 0 48px 96px -32px rgb(63 1 23 / 0.30);
  }
  /* 스크롤하면 섹션 내용이 아래에서 살짝 떠오름(html.js-motion 일 때만 — 움직임 줄이기·JS 없음이면 처음부터 보임) */
  :global(html.js-motion) .dt-sec > * { transition: opacity 0.7s var(--ease-cream), transform 0.7s var(--ease-cream); }
  :global(html.js-motion) .dt-sec:not(.is-in) > * { opacity: 0; transform: translateY(18px); }
  :global(html.js-motion) .dt-sec.is-in > :nth-child(2) { transition-delay: 0.06s; }
  :global(html.js-motion) .dt-sec.is-in > :nth-child(3) { transition-delay: 0.12s; }
  :global(html.js-motion) .dt-sec.is-in > :nth-child(n + 4) { transition-delay: 0.18s; }
  /* 사진·카드도 살짝 떠 보이게 */
  .dt-sec :global(.st-img:not(.st-ph)) { box-shadow: 0 12px 32px -12px rgb(43 26 31 / 0.35); }
  .dt-sec { display: grid; gap: var(--s-5); justify-items: center; padding: clamp(56px, 9vw, 88px) clamp(16px, 5vw, 56px); scroll-margin-top: calc(var(--header-h) + 64px); }
  .dt-sec[hidden] { display: none; }
  .dt-sec > :global(.st-img) { width: 100%; }
  .dt-tint { background: var(--c-veil); }
  .dt-ask { font-size: clamp(1rem, 1.6vw, 1.125rem); font-weight: 600; color: var(--c-burgundy); }
  .dt-title { font-size: clamp(1.625rem, 4.2vw, 2.375rem); font-weight: 700; line-height: 1.45; letter-spacing: var(--ls-head); }
  .dt-title--sm { font-size: clamp(1.375rem, 3.2vw, 1.875rem); }
  .dt-hl { display: inline-block; margin-top: 6px; padding: 0 0.35em; background: var(--c-burgundy); color: #fff; line-height: 1.5; }
  .dt-body { max-width: 34em; font-size: 1rem; line-height: 1.75; color: var(--c-ink); text-wrap: balance; }
  .dt-body > p + p { margin-top: 4px; }
  .dt-pill { padding: 4px 16px; border-radius: 999px; background: var(--c-burgundy); color: #fff; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; }

  /* ⓪ 첫 화면: 전/후 사진 아래 원형 배지 3개(사진을 가리지 않게 한 줄) */
  .dt-head { background: linear-gradient(var(--c-veil), #fff); }
  .dt-head__media { position: relative; width: min(100%, 520px); }
  .dt-head__media > :global(.st-img) { width: 100%; }
  .dt-badges { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 14px; justify-items: center; }
  .dt-badges li {
    width: 100%; max-width: 104px; aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; gap: 2px; padding: 8px;
    background: var(--c-burgundy); color: #fff; box-shadow: 0 6px 18px rgb(63 1 23 / 0.22);
  }
  .dt-badges span { font-size: 0.6875rem; font-weight: 600; line-height: 1.3; }
  @media (min-width: 900px) {
    .dt-badges li { max-width: 132px; }
    .dt-badges span { font-size: 0.8125rem; }
    .dt-badges b { font-size: 1.25rem; }
  }
  .dt-badges b { font-size: clamp(0.9375rem, 1.8vw, 1.0625rem); line-height: 1.2; }

  /* ① 혜택 */
  .dt-offer { border-block: 1px solid var(--c-line); }
  .dt-tiers { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .dt-tier { display: grid; gap: 2px; justify-items: center; padding: 18px 8px 14px; border: 1px solid var(--c-line-strong); background: var(--c-paper); }
  .dt-tier--best { border-color: var(--c-sale); box-shadow: inset 0 0 0 1px var(--c-sale); }
  .dt-tier__name { font-size: 0.875rem; font-weight: 600; }
  .dt-tier__pct { font-size: clamp(1.75rem, 5vw, 2.25rem); line-height: 1.1; color: var(--c-sale); font-variant-numeric: tabular-nums; }
  .dt-tier s { font-size: 0.75rem; color: var(--c-ink-soft); font-variant-numeric: tabular-nums; }
  .dt-tier strong { font-size: 1rem; font-variant-numeric: tabular-nums; }
  .dt-tier__tag { margin-top: 4px; font-size: 0.6875rem; font-weight: 600; padding: 0 6px; border: 1px solid var(--c-line-strong); color: var(--c-ink-soft); }
  .dt-tier--best .dt-tier__tag { background: var(--c-sale); border-color: var(--c-sale); color: #fff; }
  .dt-cta { min-width: min(100%, 320px); min-height: 56px; }

  /* ② 말풍선 */
  .dt-bubbles { width: 100%; display: grid; gap: 14px; }
  .dt-bubbles li {
    position: relative; max-width: 30em; padding: 14px 22px; border-radius: 28px; background: var(--c-burgundy); color: #fff;
    font-size: 0.9375rem; line-height: 1.6; justify-self: start; text-align: start;
  }
  .dt-bubbles li:nth-child(even) { justify-self: end; background: var(--c-plum); }
  .dt-bubbles li::after { content: ''; position: absolute; bottom: -6px; inset-inline-start: 26px; width: 14px; height: 14px; background: inherit; transform: rotate(45deg); }
  .dt-bubbles li:nth-child(even)::after { inset-inline-start: auto; inset-inline-end: 26px; }

  /* ③ 고민: 어두운 면 + 위쪽 V 홈 */
  .dt-dark { position: relative; background: var(--c-burgundy-deep); color: #fff; padding-top: calc(clamp(56px, 9vw, 88px) + 24px); }
  .dt-dark::before { content: ''; position: absolute; top: -1px; left: 50%; translate: -50% 0; width: 64px; height: 28px; background: #fff; clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .dt-photos { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .dt-photos li { display: grid; gap: 8px; font-size: 0.8125rem; }
  .dt-photos :global(.st-ph) { background: rgb(255 255 255 / 0.14); }
  .dt-down { font-size: 1.75rem; line-height: 1; opacity: 0.7; }
  .dt-turn { font-size: clamp(1.25rem, 3vw, 1.625rem); font-weight: 700; padding: 6px 16px; background: #fff; color: var(--c-burgundy-deep); }

  /* POINT 01: 고시 함량 범위 · 비교 */
  .dt-range { width: min(100%, 520px); display: grid; gap: 8px; }
  .dt-range__label { font-size: 0.8125rem; color: var(--c-ink-soft); }
  .dt-range__track { position: relative; height: 14px; border-radius: 999px; background: var(--c-pearl); margin-top: 28px; }
  .dt-range__fill { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(90deg, var(--c-gold) 0%, var(--c-burgundy) 100%); }
  .dt-range__mark { position: absolute; inset-inline-end: 0; bottom: calc(100% + 6px); font-size: 0.875rem; color: var(--c-burgundy); white-space: nowrap; }
  .dt-range__ends { display: flex; justify-content: space-between; font-size: 0.8125rem; color: var(--c-ink-soft); }
  .dt-vs { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .dt-vs__col { display: grid; gap: 6px; padding: 18px 14px; border: 1px solid var(--c-line-strong); color: var(--c-ink-soft); }
  .dt-vs__col span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; }
  .dt-vs__col--us { border-color: var(--c-burgundy); background: var(--c-burgundy); color: #fff; }
  .dt-vs__col p { font-weight: 600; }

  /* POINT 02: 큰 숫자 · 막대 */
  .dt-big { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .dt-big li { display: grid; gap: 4px; padding: 20px 10px; background: #fff; border: 1px solid var(--c-line); }
  .dt-big span { font-size: 0.875rem; color: var(--c-ink-soft); }
  .dt-big sup, .dt-bars__label sup { font-size: 0.7em; margin-inline-start: 1px; }
  .dt-big b { font-size: clamp(2rem, 6vw, 2.75rem); line-height: 1.1; color: var(--c-burgundy); }
  .dt-bars { width: 100%; display: grid; gap: 14px; text-align: start; }
  .dt-bars li { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; align-items: center; font-size: 0.9375rem; }
  .dt-bars__track { grid-column: 1 / -1; grid-row: 2; height: 12px; background: var(--c-pearl); }
  .dt-bars__track span { display: block; height: 100%; background: var(--c-plum); }
  .dt-bars__val { color: var(--c-plum); }

  /* POINT 03: 이전 → 이후 카드 · 사진 · 표 */
  .dt-cards { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .dt-cards li { display: grid; gap: 6px; padding: 18px 8px; border: 1px solid var(--c-line-strong); }
  .dt-cards li > span { font-size: 0.8125rem; color: var(--c-ink-soft); }
  .dt-cards p { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 2px 8px; }
  .dt-cards s { color: var(--c-ink-soft); font-size: 0.9375rem; }
  .dt-cards p > span { color: var(--c-ink-soft); }
