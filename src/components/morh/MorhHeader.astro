---
/*
  홈·상세 공통 헤더 (레퍼런스 '텍스쳐.png'): 왼쪽 SHOP · 가운데 버건디 MORH · 오른쪽 ABOUT / BAG
  아래 얇은 구분선과 반복 텍스트 띠. 헤더만 상단에 고정되고 텍스트 띠는 함께 스크롤됩니다.
  bagOpensSheet: 상세페이지에서는 BAG 이 구매 신청 시트를 엶 (장바구니 기능은 없음)
*/
interface Props { bagOpensSheet?: boolean }
const { bagOpensSheet = false } = Astro.props;
const PRODUCT = '/prototype/product-a/';
const words = Array.from({ length: 14 }, () => ['MORH', 'DAILY RITUAL']).flat();
---
<header class="morh-header">
  <div class="morh-header__inner">
    <nav class="morh-header__nav morh-header__nav--l" aria-label="쇼핑">
      <a href={PRODUCT}>SHOP</a>
    </nav>
    <a class="morh-header__logo" href="/" aria-label="MORH 모르 홈">MORH</a>
    <nav class="morh-header__nav morh-header__nav--r" aria-label="주요 메뉴">
      <a href="/#about">ABOUT</a>
      {bagOpensSheet
        ? <button type="button" data-buy-open aria-label="BAG — 구매 신청 열기">BAG</button>
        : <a href={PRODUCT} aria-label="BAG — 제품 상세페이지에서 구매">BAG</a>}
    </nav>
  </div>
</header>
<div class="morh-band" aria-hidden="true">
  <p>{words.map((w) => <span>{w}</span>)}</p>
</div>

<style>
  .morh-header { position: sticky; top: 0; z-index: var(--z-header); background: var(--c-paper); border-bottom: var(--border); }
  .morh-header__inner {
    height: var(--header-h); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding-inline: var(--gutter); max-width: var(--page-max); margin-inline: auto;
  }
  .morh-header__logo {
    font-family: var(--f-serif); font-weight: 600; font-size: 1.875rem; letter-spacing: 0.01em; line-height: 1;
    color: var(--c-burgundy); text-decoration: none;
  }
  .morh-header__nav { display: flex; gap: clamp(20px, 6vw, 88px); }
  .morh-header__nav--r { justify-content: flex-end; }
  .morh-header__nav a, .morh-header__nav button {
    font: inherit; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; color: var(--c-ink);
    text-decoration: none; min-height: 44px; display: inline-flex; align-items: center;
    background: none; border: 0; padding: 0; cursor: pointer;
  }
  .morh-header__nav a:hover, .morh-header__nav button:hover { color: var(--c-burgundy); text-decoration: underline; text-underline-offset: 0.5em; }
  .morh-band { border-bottom: var(--border); overflow: hidden; background: var(--c-paper); }
  .morh-band p {
    display: flex; gap: 1.6em; white-space: nowrap; padding: 6px var(--gutter);
    font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.12em; color: var(--c-ink-soft);
  }
  .morh-band span + span::before { content: '/'; margin-right: 1.6em; font-weight: 400; }
  @media (max-width: 719px) {
    .morh-header__logo { font-size: 1.5rem; }
    .morh-header__nav { gap: 18px; }
    .morh-header__nav a, .morh-header__nav button { letter-spacing: 0.1em; }
  }
</style>
