---
import PrivacyItems from './PrivacyItems.astro';
---
<dialog class="sheet privacy" id="privacy-modal" aria-labelledby="privacy-title">
  <div class="sheet__head">
    <h2 id="privacy-title">개인정보 처리 안내</h2>
    <button type="button" class="sheet__close" id="privacy-cancel" aria-label="닫기">×</button>
  </div>
  <div class="sheet__body">
    <p class="privacy__badge">개인정보 미수집 · 즉시 파기</p>
    <PrivacyItems />
    <label class="check"><input type="checkbox" id="privacy-agree" /> 위 내용을 확인했으며, 입력값이 저장되지 않고 즉시 파기된다는 점에 동의합니다.</label>
    <button type="button" class="btn btn--block" id="privacy-ok" disabled>확인했습니다</button>
  </div>
</dialog>

<style>
  .privacy__badge {
    justify-self: start; font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.02em;
    padding: 4px 10px; border: 1px solid var(--c-burgundy); color: var(--c-burgundy);
  }
</style>

<script>
  import { initPrivacy } from '../scripts/privacy';
  initPrivacy();
</script>
