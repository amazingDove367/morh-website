---
/*
  ③ Product B — Motion-based Product Showcase
  스크롤에 따라 사진 5장이 차례로 바뀌고, 각 장면에서 해당 디테일(골드 경계·몸체·01 표기 등) 쪽으로 천천히 확대됩니다.
  고정 구간은 약 2화면. 구매 정보 패널은 오른쪽에 고정되어 움직이지 않습니다.
  모션 줄이기에서는 고정 없이 사진과 설명을 순서대로 나열합니다.
*/
import { views, srcset } from '../data/product';
// 장면 순서와 확대 지점(사진 좌표 비율). 사진에서 확인한 위치 기준
const steps = [
  { key: 'front', scale: 1.0, ox: 50, oy: 50 },
  { key: 'right', scale: 1.7, ox: 50, oy: 38 },
  { key: 'left', scale: 1.35, ox: 45, oy: 62 },
  { key: 'top', scale: 1.0, ox: 50, oy: 50 },
  { key: 'back', scale: 1.5, ox: 50, oy: 60 },
] as const;
const byKey = Object.fromEntries(views.map((v) => [v.key, v]));
---
<section class="sc" aria-label="제품 외형 살펴보기 (사진 5장)" data-sc style={`--n:${steps.length}`}>
  <div class="sc__stage" aria-hidden="true">
    {steps.map((s, i) => (
      <img class="sc__img" data-i={i} data-scale={s.scale} style={`transform-origin:${s.ox}% ${s.oy}%`}
        src={`/images/morh-${s.key}-800.webp`} srcset={srcset(s.key)} sizes="(max-width: 900px) 100vw, 56vw"
        width="800" height="800" alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
    ))}
    <ol class="sc__dots" role="list">
      {steps.map((s, i) => <li data-dot={i}><span>{byKey[s.key].label}</span></li>)}
    </ol>
  </div>
  <ol class="sc__steps" role="list">
    {steps.map((s, i) => (
      <li class="sc__step" data-step={i}>
        <img class="sc__static" src={`/images/morh-${s.key}-800.webp`} srcset={srcset(s.key)} sizes="(max-width: 900px) 100vw, 56vw" width="800" height="800" loading="lazy" decoding="async" alt={byKey[s.key].alt} />
        <div class="sc__card">
          <p class="label">{String(i + 1)}/{steps.length} · {byKey[s.key].label}</p>
          <p class="sc__note">{byKey[s.key].note}</p>
        </div>
      </li>
    ))}
  </ol>
  <nav class="sc__jump" aria-label="사진 바로 보기">
    {steps.map((s, i) => <button type="button" data-jump={i}>{byKey[s.key].label}</button>)}
  </nav>
</section>

<style>
  .sc { position: relative; border: var(--border-strong); --stage-h: calc(100svh - var(--header-h) - 48px); }
  .sc__stage { position: sticky; top: calc(var(--header-h) + 24px); height: var(--stage-h); overflow: hidden; background: var(--c-paper); }
  .sc__img {
    position: absolute; inset: 0; margin: auto; width: min(100%, var(--stage-h)); height: 100%; object-fit: contain;
    opacity: 0; transition: opacity 420ms var(--ease-cream); will-change: transform, opacity;
  }
  .sc__img.is-active { opacity: 1; }
  .sc__dots { position: absolute; right: var(--s-4); top: 50%; translate: 0 -50%; display: grid; gap: 10px; }
  .sc__dots li { width: 8px; height: 8px; border: 1px solid var(--c-ink); border-radius: 50%; }
  .sc__dots li.is-active { background: var(--c-burgundy); border-color: var(--c-burgundy); }
  .sc__dots span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .sc__steps { margin-top: calc(-1 * var(--stage-h)); position: relative; z-index: 2; pointer-events: none; }
  .sc__step { height: 58vh; display: flex; align-items: flex-end; padding: var(--s-5); }
  .sc__step:first-child { height: var(--stage-h); }
  .sc__static { display: none; }
  .sc__card { pointer-events: auto; background: color-mix(in srgb, var(--c-paper) 94%, transparent); border: var(--border); padding: var(--s-3) var(--s-4); max-width: 30ch; }
  .sc__note { font-weight: 600; margin-top: 2px; }
  .sc__jump { position: relative; z-index: 3; display: grid; grid-template-columns: repeat(5, 1fr); border-top: var(--border); background: var(--c-paper); }
  .sc__jump button { min-height: 48px; border: 0; border-right: var(--border); background: none; cursor: pointer; font-size: 0.875rem; }
  .sc__jump button:last-child { border-right: 0; }
  .sc__jump button[aria-current='true'] { box-shadow: inset 0 -2px 0 var(--c-burgundy); font-weight: 700; }

  @media (max-width: 900px) {
    .sc { --stage-h: 56svh; }
    .sc__stage { top: var(--header-h); }
    .sc__step { height: 46vh; padding: var(--s-3); }
    .sc__step:first-child { height: calc(var(--stage-h) + 104px); }
  }

  /* 모션 줄이기: 고정 없이 순서대로 나열 */
  :global(.reduce-motion) .sc__stage { display: none; }
  :global(.reduce-motion) .sc__steps { margin-top: 0; pointer-events: auto; }
  :global(.reduce-motion) .sc__step, :global(.reduce-motion) .sc__step:first-child { height: auto; display: block; border-bottom: var(--border); }
  :global(.reduce-motion) .sc__static { display: block; width: 100%; aspect-ratio: 1; object-fit: contain; }
  :global(.reduce-motion) .sc__jump { display: none; }
</style>

<script>
  import { onProgress, reduced, seg, lerp, easeOut } from '../scripts/scroll';
  const root = document.querySelector<HTMLElement>('[data-sc]');
  if (root && !reduced()) {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('.sc__img')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const jumps = [...root.querySelectorAll<HTMLButtonElement>('[data-jump]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const cards = steps.map((s) => s.querySelector<HTMLElement>('.sc__card')!);
    const stage = root.querySelector<HTMLElement>('.sc__stage')!;
    const stepsEl = root.querySelector<HTMLElement>('.sc__steps')!;
    const n = imgs.length;
    const mobile = matchMedia('(max-width: 900px)'); // 모바일: 카드는 사진 아래에서 읽힘
    let active = -1;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      imgs.forEach((im, k) => im.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
      jumps.forEach((b, k) => (k === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
    };
    onProgress(stepsEl, 'pass', () => {
      // 설명 카드가 '읽는 선'(무대 하단 부근)을 지나면 그 장면을 활성화 → 보이는 카드와 사진이 항상 일치
      const line = stage.getBoundingClientRect().bottom + (mobile.matches ? 104 : -8);
      let i = 0;
      cards.forEach((c, k) => { if (c.getBoundingClientRect().top < line) i = k; });
      const top = cards[i].getBoundingClientRect().top;
      const next = cards[i + 1]?.getBoundingClientRect().top ?? top + steps[i].offsetHeight;
      const t = seg((line - top) / Math.max(1, next - top), 0, 1);
      setActive(Math.min(n - 1, i));
      const im = imgs[i];
      im.style.transform = `scale(${lerp(1, Number(im.dataset.scale), easeOut(seg(t, 0.05, 0.7)))})`;
    });
    jumps.forEach((b, k) => b.addEventListener('click', () => {
      // 해당 카드가 읽는 선 바로 위에 오도록 이동 (사용자가 누른 경우에만)
      const delta = cards[k].getBoundingClientRect().top - (stage.getBoundingClientRect().bottom + (mobile.matches ? 60 : -40));
      scrollTo({ top: scrollY + delta + (k === 0 ? -400 : 0), behavior: 'smooth' });
    }));
  }
</script>
