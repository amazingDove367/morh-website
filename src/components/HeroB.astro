---
/*
  ① Hero B — Floating Product
  같은 문구·이미지. 용기 정면 사진이 천천히 떠 있는 듯 움직이고(상하 8px), 그림자가 함께 숨쉽니다.
  회전·3D 연출은 하지 않습니다(정지 사진 1장이므로).
*/
import { copy, product } from '../data/product';
---
<section class="hero-b" aria-labelledby="hero-b-title" data-hero-b>
  <div class="wrap hero-b__grid">
    <p class="hero-b__eyebrow label"><span class="serif-i">MORH</span> · {product.category}</p>

    <h1 id="hero-b-title" class="hero-b__title">
      <span class="line">컨실러로 한 겹 더</span>
      <span class="line">가리지 않아도,</span>
      <span class="line">내 피부가 마음에</span>
      <span class="line">드는 <em class="serif-i">아침.</em></span>
    </h1>

    <div class="hero-b__stage">
      <div class="hero-b__float">
        <img src="/images/morh-front-800.webp"
             srcset="/images/morh-front-400.webp 400w, /images/morh-front-800.webp 800w, /images/morh-front-1254.webp 1254w"
             sizes="(max-width: 720px) 78vw, 42vw" width="800" height="800" fetchpriority="high"
             alt="모르 브라이트닝 크림 정면. 둥글게 부푼 아이보리 뚜껑과 버건디 MORH 로고가 있는 낮은 원통형 용기" />
      </div>
      <div class="hero-b__shadow" aria-hidden="true"></div>
    </div>

    <div class="hero-b__foot">
      <figure class="hero-b__swatch" aria-hidden="true">
        <img src="/images/cream-texture-420.webp" width="420" height="560" alt="" />
      </figure>
      <p class="hero-b__sub">
        <strong>{product.fullName}</strong><br />
        {copy.strategy} <span class="test-tag test-tag--plan"></span>
      </p>
      <a class="btn" href="/prototype/product-b/">{copy.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hero-b { position: relative; overflow: clip; min-height: calc(100svh - var(--header-h)); display: flex; }
  .hero-b__grid {
    position: relative; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--col-gap);
    grid-template-rows: auto 1fr auto; padding-block: clamp(20px, 4vh, 48px) clamp(24px, 5vh, 56px); row-gap: var(--s-5);
  }
  .hero-b__eyebrow { grid-column: 1 / -1; }
  .hero-b__title {
    grid-column: 1 / 8; grid-row: 2; align-self: center; position: relative; z-index: 2;
    font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: var(--ls-display); font-weight: 700;
  }
  .hero-b__title .line { display: block; }
  .hero-b__title em { font-weight: 500; font-size: 1.12em; color: var(--c-burgundy); letter-spacing: -0.01em; }

  .hero-b__stage { grid-column: 7 / -1; grid-row: 2; align-self: center; position: relative; z-index: 1; }
  .hero-b__float { width: min(100%, 620px, 56vh); margin-inline: auto; will-change: transform; }
  .hero-b__float img { width: 100%; }
  .hero-b__shadow {
    width: 52%; height: 22px; margin: -6% auto 0; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(43, 26, 31, 0.22), transparent);
  }
  :global(.js-motion) .hero-b__float { animation: float 6s var(--ease-inout) infinite alternate; }
  :global(.js-motion) .hero-b__shadow { animation: breathe 6s var(--ease-inout) infinite alternate; }
  @keyframes float { from { transform: translateY(4px); } to { transform: translateY(-8px); } }
  @keyframes breathe { from { transform: scaleX(1); opacity: 1; } to { transform: scaleX(0.86); opacity: 0.7; } }

  .hero-b__foot { grid-column: 1 / -1; grid-row: 3; display: flex; flex-wrap: wrap; align-items: end; gap: var(--s-5); justify-content: space-between; }
  .hero-b__swatch { margin: 0; width: 64px; border: var(--border); background: #fff; }
  .hero-b__sub { flex: 1 1 280px; max-width: 40ch; font-size: var(--fs-lead); line-height: 1.6; }
  .hero-b__sub strong { font-weight: 650; font-size: var(--fs-small); }

  @media (max-width: 720px) {
    .hero-b__grid { grid-template-rows: auto auto auto auto; }
    .hero-b__title { grid-column: 1 / -1; font-size: clamp(2.4rem, 11.4vw, 3.4rem); }
    .hero-b__stage { grid-column: 1 / -1; grid-row: 3; margin-top: -2vh; }
    .hero-b__float { width: 62vw; }
    .hero-b__foot { grid-row: 4; }
    .hero-b__swatch { display: none; }
    .hero-b__foot .btn { width: 100%; }
  }
</style>

<script>
  import { onProgress, reduced, lerp } from '../scripts/scroll';
  const root = document.querySelector<HTMLElement>('[data-hero-b]');
  if (root && !reduced()) {
    const stage = root.querySelector<HTMLElement>('.hero-b__stage');
    onProgress(root, 'pass', (p) => {
      const t = Math.max(0, (p - 0.5) * 2);
      if (stage) stage.style.transform = `translateY(${lerp(0, -10, t)}vh) scale(${lerp(1, 0.92, t)})`;
    });
  }
</script>
