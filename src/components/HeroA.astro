---
/*
  ① Hero A — Typography × Texture
  큰 한글 타이포 사이로 크림 텍스처가 아래에서 위로 펴 바르듯 드러나고, 글자 뒤에 겹칩니다.
  - 텍스처는 글자 '뒤' 레이어 + multiply → 흰 배경이 종이색에 녹아 이음새가 없고, 글자 대비 유지
  - 텍스처 원본 420×560px: 데스크톱 표시 폭을 최대 400px로 제한(업스케일 최소화)
*/
import { copy, product } from '../data/product';
---
<section class="hero-a" aria-labelledby="hero-a-title" data-hero-a>
  <div class="wrap hero-a__grid">
    <p class="hero-a__eyebrow label"><span class="serif-i">MORH</span> · {product.category}</p>

    <figure class="hero-a__tex" aria-hidden="true">
      <img src="/images/cream-texture-420.webp" width="420" height="560" alt="" fetchpriority="high" decoding="async" />
    </figure>

    <h1 id="hero-a-title" class="hero-a__title">
      <span class="line" data-line="1">컨실러로 한 겹 더</span>
      <span class="line" data-line="2">가리지 않아도,</span>
      <span class="line" data-line="3">내 피부가 마음에</span>
      <span class="line" data-line="4">드는 <em class="serif-i">아침.</em></span>
    </h1>

    <div class="hero-a__foot">
      <p class="hero-a__sub">
        <strong>{product.fullName}</strong><br />
        {copy.strategy} <span class="test-tag test-tag--plan"></span>
      </p>
      <div class="hero-a__actions">
        <a class="btn" href="/prototype/product-a/">{copy.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="product-chip" href="/prototype/product-a/">
          <img src="/images/morh-front-400.webp" width="400" height="400" alt="모르 브라이트닝 크림 정면" />
          <span>제품 보기</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-a { position: relative; overflow: clip; min-height: calc(100svh - var(--header-h)); display: flex; }
  .hero-a__grid {
    position: relative; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--col-gap);
    align-content: space-between; padding-block: clamp(20px, 4vh, 48px) clamp(24px, 5vh, 56px); gap: var(--s-5) var(--col-gap);
  }
  .hero-a__eyebrow { grid-column: 1 / -1; }
  .hero-a__title {
    position: relative; z-index: 2; grid-column: 1 / -1;
    font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: var(--ls-display); font-weight: 700;
    color: var(--c-ink);
  }
  .hero-a__title .line { display: block; }
  .hero-a__title .line[data-line='2'] { padding-left: 1.4em; }
  .hero-a__title .line[data-line='4'] { padding-left: 3.2em; }
  .hero-a__title em { font-weight: 500; font-size: 1.12em; color: var(--c-burgundy); letter-spacing: -0.01em; }

  /* 텍스처: 글자 뒤, 2~4행에 걸쳐 겹침 */
  .hero-a__tex {
    position: absolute; z-index: 1; margin: 0;
    width: clamp(220px, 28vw, 400px); right: calc(var(--gutter) + 24vw); top: 52%;
    translate: 0 -50%; mix-blend-mode: multiply; pointer-events: none;
  }
  .hero-a__tex img { width: 100%; height: auto; }

  .hero-a__foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-5); position: relative; z-index: 2; }
  .hero-a__sub { max-width: 34ch; font-size: var(--fs-lead); line-height: 1.6; }
  .hero-a__sub strong { font-weight: 650; font-size: var(--fs-small); letter-spacing: 0.01em; }
  .hero-a__actions { display: flex; align-items: center; gap: var(--s-4); }
  .product-chip { display: flex; align-items: center; gap: var(--s-3); text-decoration: none; border: var(--border); padding: 4px var(--s-4) 4px 4px; font-size: var(--fs-small); font-weight: 600; min-height: 52px; }
  .product-chip img { width: 44px; height: 44px; object-fit: contain; background: var(--c-ivory); }
  .product-chip:hover { border-color: var(--c-ink); }

  /* 진입 연출: 글자는 처음부터 보이고(LCP 보호) 위치만 살짝 이동, 텍스처는 아래→위로 드러남 */
  :global(.js-motion) .hero-a__tex img { animation: tex-spread var(--dur-hero) var(--ease-cream) 120ms both; }
  :global(.js-motion) .hero-a__title .line { animation: line-rise 900ms var(--ease-cream) both; }
  :global(.js-motion) .hero-a__title .line[data-line='2'] { animation-delay: 70ms; }
  :global(.js-motion) .hero-a__title .line[data-line='3'] { animation-delay: 140ms; }
  :global(.js-motion) .hero-a__title .line[data-line='4'] { animation-delay: 210ms; }
  @keyframes tex-spread {
    from { clip-path: inset(100% 0 0 0); transform: scale(1.06) translateY(4%); }
    to { clip-path: inset(0 0 0 0); transform: none; }
  }
  @keyframes line-rise { from { transform: translateY(0.18em); } to { transform: none; } }

  @media (max-width: 720px) {
    .hero-a__grid { align-content: start; row-gap: 28px; padding-top: 20px; }
    .hero-a__title { font-size: clamp(2.4rem, 11.4vw, 3.4rem); }
    .hero-a__title .line[data-line='2'] { padding-left: 0.8em; }
    .hero-a__title .line[data-line='4'] { padding-left: 1.6em; }
    .hero-a__tex { width: 50vw; right: 0; top: 36%; }
    .hero-a__actions { width: 100%; }
    .hero-a__actions .btn { flex: 1; }
  }
</style>

<script>
  import { onProgress, reduced, lerp } from '../scripts/scroll';
  const root = document.querySelector<HTMLElement>('[data-hero-a]');
  if (root && !reduced()) {
    const tex = root.querySelector<HTMLElement>('.hero-a__tex');
    const lines = root.querySelectorAll<HTMLElement>('.hero-a__title .line');
    // 첫 화면을 벗어나는 동안: 텍스처는 느리게 올라가며 조금 커지고, 행은 좌우로 미세하게 엇갈림
    onProgress(root, 'pass', (p) => {
      const t = Math.max(0, (p - 0.5) * 2); // 화면 상단이 히어로를 지나기 시작한 뒤부터
      if (tex) tex.style.transform = `translateY(${lerp(0, -8, t)}vh) scale(${lerp(1, 1.12, t)})`;
      lines.forEach((l, i) => { l.style.translate = `${(i % 2 ? -1 : 1) * t * 3}vw 0`; });
    });
  }
</script>
