---
/* 탭 뒤 공통 콘텐츠: 어느 탭을 선택해도 이어지는 FAQ · 상품 필수 정보 · 배송·교환 · 마지막 구매 유도 */
import { product, formatKRW } from '../data/product';
const faqs = [
  { q: '톤업 크림인가요?', a: '아닙니다. 바르는 즉시 피부색을 바꾸는 톤업 제품이 아니라, 매일 바르며 피부 톤을 가꾸는 미백 크림으로 기획된 제품입니다. 미백 기능성 여부는 심사·보고 자료 확인 후 표기합니다.' },
  { q: '언제 바르나요?', a: '아침·저녁 스킨케어 마지막 단계에 사용하고, 아침에는 선크림으로 마무리합니다.' },
  { q: '용기 뒷면의 01은 무엇인가요?', a: '용기 뒷면에 인쇄된 표기입니다. 용량이나 효능을 뜻하는 숫자로 확인된 정보는 없습니다.' },
  { q: '실제로 구매할 수 있나요?', a: '이 페이지는 포트폴리오 데모입니다. 구매 신청 화면까지 체험할 수 있지만 실제 결제·배송은 진행되지 않습니다.' },
];
const required = [
  ['내용물의 용량 또는 중량', null],
  ['제품 주요 사양 (피부 타입 등)', null],
  ['사용기한 또는 개봉 후 사용기간', null],
  ['사용방법', '아침·저녁 스킨케어 마지막 단계'],
  ['화장품제조업자 / 책임판매업자', null],
  ['제조국', null],
  ['화장품법에 따라 기재해야 하는 모든 성분', null],
  ['기능성 화장품 심사·보고 여부', null],
  ['사용 시 주의사항', null],
  ['품질보증기준', null],
  ['소비자상담 전화번호', null],
] as const;
---
<section class="info wrap" aria-label="자주 묻는 질문과 상품 정보">
  <div class="info__block" id="faq">
    <h2>자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>

  <div class="info__block" id="info-required">
    <h2>상품 필수 정보</h2>
    <p class="muted small">화장품 상품정보제공 고시 항목입니다. 자료가 확인되지 않은 항목은 비워 두었습니다.</p>
    <table class="spec">
      <tbody>
        {required.map(([k, v]) => (
          <tr><th scope="row">{k}</th><td>{v ?? <span class="test-tag test-tag--tbd"></span>}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="info__block" id="info-shipping">
    <h2>배송·교환 안내</h2>
    <p>이 사이트는 포트폴리오 데모로 <b>실제 주문·결제·배송·교환·환불이 발생하지 않습니다.</b> 실제 판매 시에는 배송 기간·배송비·교환 및 반품 조건(전자상거래법상 청약철회 기간 포함)과 사업자 정보를 이 영역과 하단에 기재해야 합니다.</p>
  </div>

  <div class="info__cta">
    <div>
      <p class="label">MORH</p>
      <p class="info__cta-name">{product.name}</p>
      <p class="muted">{formatKRW(product.price.value)} <span class="test-tag test-tag--sample"></span></p>
    </div>
    <button type="button" class="btn" data-buy-open>구매하기 <span class="arrow" aria-hidden="true">→</span></button>
  </div>
</section>

<style>
  .info { display: grid; gap: var(--s-8); margin-top: var(--s-9); }
  .info__block { display: grid; grid-template-columns: 1fr 2fr; gap: var(--s-5) var(--col-gap); border-top: var(--border-strong); padding-top: var(--s-5); }
  .info__block h2 { font-size: var(--fs-h3); }
  .info__block > :not(h2) { grid-column: 2; }
  .faq details { border-bottom: var(--border); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: var(--s-4); padding: var(--s-4) 0; font-weight: 600; min-height: 48px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-weight: 400; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { padding-bottom: var(--s-4); color: var(--c-ink-soft); max-width: 60ch; }
  .spec { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .spec th, .spec td { text-align: left; padding: var(--s-3) 0; border-bottom: var(--border); vertical-align: top; }
  .spec th { font-weight: 500; color: var(--c-ink-soft); width: 46%; padding-right: var(--s-4); }
  .small { font-size: 0.875rem; }
  .info__cta { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); flex-wrap: wrap; border: var(--border-strong); padding: var(--s-5); }
  .info__cta-name { font-size: var(--fs-h3); font-weight: 650; }
  @media (max-width: 720px) {
    .info__block { grid-template-columns: 1fr; }
    .info__block > :not(h2) { grid-column: 1; }
    .info__cta .btn { width: 100%; }
  }
</style>
