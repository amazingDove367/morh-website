---
import { product, copy, formatKRW, sampleRating } from '../data/product';
interface Props { headingId?: string }
const { headingId = 'product-title' } = Astro.props;
---
<section class="buy" aria-labelledby={headingId} data-buy-panel>
  <div class="buy__row buy__row--split">
    <a class="buy__back" href="/">← 홈으로</a>
    <span class="label">MORH</span>
  </div>
  <div class="buy__row">
    <p class="label">{product.category}</p>
    <h1 id={headingId} class="buy__title">{product.name}</h1>
    <a class="buy__rating" href="#reviews" data-tab-link="reviews">
      <span aria-hidden="true">★</span> {sampleRating.average.toFixed(1)}
      <span class="muted">· 후기 {sampleRating.count}건</span>
      <span class="test-tag test-tag--sample"></span>
    </a>
  </div>
  <div class="buy__row buy__row--split buy__row--price">
    <p class="buy__price">
      <span class="visually-hidden">판매가</span>
      <strong data-unit-price={product.price.value}>{formatKRW(product.price.value)}</strong>
      <span class="test-tag test-tag--sample"></span>
    </p>
    <div class="qty" role="group" aria-label="수량">
      <button type="button" class="qty__btn" data-qty="-1" aria-label="수량 줄이기">−</button>
      <output class="qty__val" data-qty-value aria-live="polite">1</output>
      <button type="button" class="qty__btn" data-qty="1" aria-label="수량 늘리기">+</button>
    </div>
  </div>
  <div class="buy__row">
    <p class="buy__summary">{copy.tagline} {copy.support} <span class="test-tag test-tag--plan"></span></p>
  </div>
  <dl class="buy__row buy__specs">
    <div><dt>용량</dt><dd>확인 필요 <span class="test-tag test-tag--tbd"></span></dd></div>
    <div><dt>사용 단계</dt><dd>아침·저녁 스킨케어 마지막 단계</dd></div>
    <div><dt>용기</dt><dd>낮은 원통형 · 아이보리 뚜껑 · 골드 경계</dd></div>
  </dl>
  <div class="buy__row buy__row--split buy__total">
    <span>총 상품금액</span>
    <strong data-total>{formatKRW(product.price.value)}</strong>
  </div>
  <div class="buy__row buy__row--cta">
    <button type="button" class="btn btn--block" id="cta-main" data-buy-open>구매하기</button>
    <p class="buy__demo">데모 결제 · 실제 결제·배송은 진행되지 않습니다. <button type="button" class="linklike" data-privacy-open>개인정보 처리 안내</button></p>
  </div>
</section>

<style>
  .buy { border: var(--border-strong); background: var(--c-paper); }
  .buy__row { padding: var(--s-4) var(--s-5); border-bottom: var(--border); }
  .buy__row:last-child { border-bottom: 0; }
  .buy__row--split { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); }
  .buy__back { font-size: var(--fs-small); text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .buy__back:hover { text-decoration: underline; }
  .buy__title { font-size: clamp(1.6rem, 2.4vw, 2.1rem); margin-top: var(--s-1); }
  .buy__rating { display: inline-flex; gap: 6px; align-items: center; margin-top: var(--s-2); font-size: var(--fs-small); text-decoration: none; min-height: 32px; }
  .buy__rating:hover { text-decoration: underline; }
  .buy__price { display: flex; align-items: center; gap: var(--s-2); }
  .buy__price strong { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .qty { display: inline-flex; align-items: center; border: var(--border-strong); }
  .qty__btn { width: 44px; height: 44px; border: 0; background: none; cursor: pointer; font-size: 1.25rem; }
  .qty__btn:hover { background: var(--c-ivory); }
  .qty__val { min-width: 2.2em; text-align: center; font-variant-numeric: tabular-nums; font-weight: 600; }
  .buy__summary { font-size: var(--fs-small); line-height: 1.7; color: var(--c-ink-soft); }
  .buy__specs { display: grid; gap: var(--s-2); font-size: var(--fs-small); }
  .buy__specs div { display: grid; grid-template-columns: 6.5em 1fr; gap: var(--s-3); }
  .buy__specs dt { color: var(--c-ink-soft); }
  .buy__total strong { font-size: 1.25rem; font-variant-numeric: tabular-nums; }
  .buy__row--cta { display: grid; gap: var(--s-3); }
  .buy__demo { font-size: 0.875rem; color: var(--c-ink-soft); }
  .linklike { background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; font-size: inherit; color: var(--c-ink); }
</style>
