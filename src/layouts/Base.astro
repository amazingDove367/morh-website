---
/*
  모든 페이지 공통 레이아웃: 언어·방향(lang/dir), 메타·검색 설정, 헤더·하단 띠·푸터, 분석 스크립트(설정된 경우만)
  - 검색 노출: PUBLIC_INDEXABLE=true 인 운영 배포에서만 index. 미리보기·로컬은 항상 noindex
  - canonical·hreflang: PUBLIC_SITE_URL 이 있을 때만(임의 주소를 만들지 않음)
  - 움직임 줄이기: OS 설정 또는 ?motion=off → html.reduce-motion (정적 장면), 그 외 html.js-motion
*/
import '../styles/base.css';
import MorhHeader from '../components/morh/MorhHeader.astro';
import MorhBand from '../components/morh/MorhBand.astro';
import MorhFooter from '../components/morh/MorhFooter.astro';
import { LOCALES, LOCALE_META, localePath, withBase, type Locale } from '../i18n/locales';
import { DICTS } from '../i18n';

interface Props {
  locale: Locale;
  /** 언어 접두어 없는 경로 ('/', '/product/') — 언어 전환·hreflang 에 사용 */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>;
  ogImage?: string;
  bagOpensCheckout?: boolean;
}

const { locale, path, title, description, noindex = false, jsonld, ogImage = '/images/morh-front-1254.webp', bagOpensCheckout = false } = Astro.props;
const t = DICTS[locale];
const meta = LOCALE_META[locale];
const env = import.meta.env;
const indexable = env.PUBLIC_INDEXABLE === 'true' && !noindex;
const site = (env.PUBLIC_SITE_URL || '').replace(/\/$/, '');
const abs = (p: string) => (site ? `${site}${p}` : p);
const ga = (env.PUBLIC_GA4_ID || '').trim();
const gaValid = /^G-[A-Z0-9]{4,}$/.test(ga);
---
<!doctype html>
<html lang={meta.html} dir={meta.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  {site && <link rel="canonical" href={abs(localePath(locale, path))} />}
  {site && LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].html} href={abs(localePath(l, path))} />)}
  {site && <link rel="alternate" hreflang="x-default" href={abs(localePath('ko', path))} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={t.meta.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={abs(withBase(ogImage))} />
  <meta property="og:locale" content={meta.og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#fcfaf6" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>
    (function () {
      var d = document.documentElement, q = new URLSearchParams(location.search);
      var reduce = q.get('motion') === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches;
      d.classList.add(reduce ? 'reduce-motion' : 'js-motion');
      window.__events = [];
    })();
  </script>
  {gaValid && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
      <script is:inline define:vars={{ ga }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', ga);
      </script>
    </>
  )}
</head>
<body>
  <a class="skip-link" href="#main">{t.a11y.skip}</a>
  <MorhHeader locale={locale} path={path} bagOpensCheckout={bagOpensCheckout} />
  <main id="main">
    <slot />
  </main>
  <MorhBand />
  <MorhFooter locale={locale} />
  <slot name="after" />
</body>
</html>
