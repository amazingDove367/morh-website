---
/*
  모든 페이지 공통 레이아웃: 언어·방향(lang/dir), 메타·검색 설정, 헤더·하단 띠·푸터, 분석 스크립트(GTM·GA4·Meta 픽셀, 설정된 경우만)
  - 검색 노출: PUBLIC_INDEXABLE=true 인 운영 배포에서만 index. 미리보기·로컬은 항상 noindex
  - canonical·hreflang: PUBLIC_SITE_URL 이 있을 때만(임의 주소를 만들지 않음)
  - 움직임 줄이기: OS 설정 또는 ?motion=off → html.reduce-motion (정적 장면), 그 외 html.js-motion
*/
import '../styles/base.css';
import MorhHeader from '../components/morh/MorhHeader.astro';
import MorhBand from '../components/morh/MorhBand.astro';
import MorhFooter from '../components/morh/MorhFooter.astro';
import { LOCALES, LOCALE_META, localePath, withBase, type Locale } from '../i18n/locales';
import { DICTS } from '../i18n';

interface Props {
  locale: Locale;
  /** 언어 접두어 없는 경로 ('/', '/product/') — 언어 전환·hreflang 에 사용 */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>;
  ogImage?: string;
  bagOpensCheckout?: boolean;
  /** 측정용 화면 종류(page_type) */
  pageType: 'home' | 'product' | 'checkout' | 'complete' | 'privacy' | 'not_found' | 'qa';
}

const { locale, path, title, description, noindex = false, jsonld, ogImage = '/images/morh-front-1254.webp', bagOpensCheckout = false, pageType } = Astro.props;
const t = DICTS[locale];
const meta = LOCALE_META[locale];
const env = import.meta.env;
const indexable = env.PUBLIC_INDEXABLE === 'true' && !noindex;
const site = (env.PUBLIC_SITE_URL || '').replace(/\/$/, '');
const abs = (p: string) => (site ? `${site}${p}` : p);
const ga = (env.PUBLIC_GA4_ID || '').trim();
const gaValid = /^G-[A-Z0-9]{4,}$/.test(ga);
// Google 태그 관리자: <head> 맨 위(charset 바로 다음). GA4 코드와 별개로 둠
const gtm = (env.PUBLIC_GTM_ID || '').trim();
const gtmValid = /^GTM-[A-Z0-9]{4,}$/.test(gtm);
// Meta 픽셀: </head> 바로 앞. GA4·GTM 과 같이 운영 배포에서만
const pixel = (env.PUBLIC_META_PIXEL_ID || '').trim();
const pixelValid = /^\d{10,20}$/.test(pixel);
---
<!doctype html>
<html lang={meta.html} dir={meta.dir} data-locale={locale}>
<head>
  <meta charset="utf-8" />
  {gtmValid && (
    <>
      <script async src={`https://www.googletagmanager.com/gtm.js?id=${gtm}`}></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
      </script>
    </>
  )}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  {site && <link rel="canonical" href={abs(localePath(locale, path))} />}
  {site && LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].html} href={abs(localePath(l, path))} />)}
  {site && <link rel="alternate" hreflang="x-default" href={abs(localePath('ko', path))} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={t.meta.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={abs(withBase(ogImage))} />
  <meta property="og:locale" content={meta.og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#fcfaf6" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>
    (function () {
      var d = document.documentElement, q = new URLSearchParams(location.search);
      var reduce = q.get('motion') === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches;
      d.classList.add(reduce ? 'reduce-motion' : 'js-motion');
      window.__events = [];
    })();
  </script>
  {gaValid && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
      <script is:inline define:vars={{ ga }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        // ?ga_debug=1 로 열면 GA4 DebugView 에 바로 표시
        window.gtag('config', ga, new URLSearchParams(location.search).get('ga_debug') === '1' ? { debug_mode: true } : {});
      </script>
    </>
  )}
  {pixelValid && (
    <>
      <!-- Meta Pixel Code -->
      <script is:inline define:vars={{ pixel }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixel);
      fbq('track', 'PageView');
      </script>
      <noscript><img height="1" width="1" style="display:none"
      src={`https://www.facebook.com/tr?id=${pixel}&ev=PageView&noscript=1`}
      /></noscript>
      <!-- End Meta Pixel Code -->
    </>
  )}
</head>
<body data-page={pageType}>
  <a class="skip-link" href="#main" data-ga="nav_click" data-ga-menu-name="skip_to_content" data-ga-menu-location="header">{t.a11y.skip}</a>
  <MorhHeader locale={locale} path={path} bagOpensCheckout={bagOpensCheckout} />
  <main id="main">
    <slot />
  </main>
  <MorhBand />
  <MorhFooter locale={locale} />
  <slot name="after" />
  <script>
    import { initClickTracking } from '../scripts/analytics';
    initClickTracking();
  </script>
</body>
</html>
