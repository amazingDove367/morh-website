---
/* 1단계 비교 허브 (2단계에서 실제 홈으로 교체) */
import Base from '../../layouts/Base.astro';

const W = { brand: 0.3, visual: 0.25, ux: 0.2, mobile: 0.15, seo: 0.1 };
type Row = { v: string; name: string; href: string; s: [number, number, number, number, number]; pros: string[]; cons: string[] };
type Area = { id: string; title: string; rows: [Row, Row]; pick: string };
const total = (s: Row['s']) => s[0] * W.brand + s[1] * W.visual + s[2] * W.ux + s[3] * W.mobile + s[4] * W.seo;

const areas: Area[] = [
  {
    id: 'hero', title: '① 홈 첫 화면 — Hero Motion', pick: 'A',
    rows: [
      { v: 'A', name: 'Typography × Texture', href: '/prototype/hero-a/', s: [9, 8, 8, 8, 9],
        pros: ['실제 크림 텍스처가 대표 문구와 겹쳐 MORH만의 장면이 됨', '첫 화면에 문구·제품명·CTA·제품 칩이 모두 보임(데스크톱·모바일 확인)', '첫 로드 이미지 약 11KB'],
        cons: ['텍스처 원본이 420×560px라 크게 키울 수 없음(표시 폭 최대 400px)', '모바일에서 텍스처가 3~4행과 겹침 — 대비는 충분하지만 취향 판단 필요'] },
      { v: 'B', name: 'Floating Product', href: '/prototype/hero-b/', s: [8, 7, 8.5, 8, 9],
        pros: ['용기가 가장 크게 보여 무엇을 파는지 즉시 인지', '로고·뚜껑 곡률이 첫 화면에서 선명'],
        cons: ['떠 있는 제품 연출은 흔한 형식이라 기억에 남는 차별성이 약함', '모바일에서 용기가 공간을 많이 써 CTA가 첫 화면 하단에 걸림'] },
    ],
  },
  {
    id: 'transition', title: '② 홈 스크롤 — Section Transition', pick: 'A',
    rows: [
      { v: 'A', name: 'Texture Zoom Transition', href: '/prototype/transition-a/', s: [9, 8.5, 7.5, 7, 8],
        pros: ['크림 속으로 들어가 크림색 면이 다음 섹션 배경이 되는 연결이 가장 분명함', '스크롤을 가로채지 않음, 고정 구간 약 1.2화면'],
        cons: ['원본 해상도 한계로 4.5배에서 확대를 멈추고 면 색으로 덮음 — 고해상도 텍스처가 있으면 품질 향상', '끝 문장이 스크롤 후반에 나타남(초기 HTML에는 있음)'] },
      { v: 'B', name: 'Layered Scroll Transition', href: '/prototype/transition-b/', s: [7.5, 7, 8.5, 8, 8.5],
        pros: ['고정 구간이 없어 스크롤이 가장 자연스러움', '모든 문장이 처음부터 보임'],
        cons: ['층이 움직이지만 장면이 하나로 “이어진다”는 느낌은 A보다 약함', '제품·텍스처가 장식처럼 흩어져 보일 수 있음'] },
    ],
  },
  {
    id: 'product', title: '③ 상세페이지 — Product Interaction', pick: 'A',
    rows: [
      { v: 'A', name: 'Interactive Product Gallery', href: '/prototype/product-a/', s: [8, 7.5, 9, 9, 9],
        pros: ['원하는 사진을 바로 선택·2.2배 확대(1254px 원본), 클릭·탭·키보드 모두 확인', '구매 정보 패널이 움직이지 않고 데스크톱 첫 화면에 사진·가격·구매 버튼이 함께 보임'],
        cons: ['연출이 절제되어 홈과의 감각적 연결은 상세 설명 탭에서 보완 필요'] },
      { v: 'B', name: 'Motion-based Product Showcase', href: '/prototype/product-b/', s: [8.5, 8.5, 6.5, 6.5, 8],
        pros: ['골드 경계·서리 낀 몸체·01 표기 등 디테일을 이야기처럼 보여 줌', '데스크톱에서는 오른쪽 구매 패널이 고정돼 흐름을 방해하지 않음'],
        cons: ['원하는 사진을 바로 고르기 어렵고(바로가기 버튼으로 보완) 고정 구간 약 2화면', '모바일에서 제품명·가격이 쇼케이스 뒤로 밀림(하단 바로 보완), 페이지가 약 27% 길어짐'] },
    ],
  },
];
---
<Base title="MORH 프로토타입 비교 허브" description="MORH 홈·상세페이지 핵심 인터랙션 A/B 프로토타입 비교 허브" header={false}>
  <div class="hub wrap">
    <header class="hub__head">
      <p class="label">MORH · Phase 1 · 사용자 선택 대기</p>
      <h1>핵심 인터랙션 A/B 프로토타입</h1>
      <p class="lead">세 영역의 A/B안을 같은 이미지·문구·색상·화면 크기로 만들었습니다. 각 안을 직접 열어 보고 선택해 주세요.</p>
      <nav class="hub__quick" aria-label="바로가기">
        <a class="btn" href="/prototype/compare/">A/B 나란히 비교</a>
        <a class="btn btn--ghost" href="/prototype/story/">추천 조합 연결 보기 (Hero A → Zoom A)</a>
        <a class="btn btn--ghost" href="/prototype/system/">디자인 시스템 초안</a>
      </nav>
    </header>

    {areas.map((a) => (
      <section class="area" aria-labelledby={`a-${a.id}`}>
        <h2 id={`a-${a.id}`}>{a.title}</h2>
        <div class="area__cards">
          {a.rows.map((r) => (
            <article class:list={['card', { 'card--pick': r.v === a.pick }]}>
              <p class="label">{r.v}안 {r.v === a.pick && <span class="pick">추천</span>}</p>
              <h3><a href={r.href}>{r.name}</a></h3>
              <p class="score"><strong>{total(r.s).toFixed(2)}</strong> / 10</p>
              <table class="sc">
                <tbody>
                  <tr><th scope="row">브랜드 적합성 30%</th><td>{r.s[0]}</td></tr>
                  <tr><th scope="row">시각적 완성도·차별성 25%</th><td>{r.s[1]}</td></tr>
                  <tr><th scope="row">사용성·구매 흐름 20%</th><td>{r.s[2]}</td></tr>
                  <tr><th scope="row">모바일 성능·접근성 15%</th><td>{r.s[3]}</td></tr>
                  <tr><th scope="row">검색·AI가 읽는 구조 10%</th><td>{r.s[4]}</td></tr>
                </tbody>
              </table>
              <ul class="pc">{r.pros.map((p) => <li class="pro">{p}</li>)}{r.cons.map((c) => <li class="con">{c}</li>)}</ul>
              <a class="text-link" href={r.href}>{r.v}안 열기 →</a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="area" aria-labelledby="a-note">
      <h2 id="a-note">점수 읽는 법</h2>
      <p class="muted">사용성·모바일·검색 구조 항목은 자동 검증(123개 항목 통과)과 스크린샷으로 확인한 사실을 근거로 했고, 브랜드 적합성·시각적 완성도는 디자인 판단(주관)입니다. 실제 구매 전환 효과나 실기기 성능은 측정하지 않았습니다.</p>
    </section>
  </div>
</Base>

<style>
  .hub { padding-block: var(--s-7) var(--s-9); display: grid; gap: var(--s-8); }
  .hub__head { display: grid; gap: var(--s-4); }
  .hub__head h1 { font-size: var(--fs-h1); }
  .hub__head .lead { max-width: 60ch; }
  .hub__quick { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .area { display: grid; gap: var(--s-4); border-top: var(--border-strong); padding-top: var(--s-5); }
  .area h2 { font-size: var(--fs-h3); }
  .area__cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--col-gap); }
  .card { border: var(--border); padding: var(--s-5); display: grid; gap: var(--s-3); align-content: start; }
  .card--pick { border: 1px solid var(--c-burgundy); box-shadow: inset 0 3px 0 var(--c-burgundy); }
  .pick { background: var(--c-burgundy); color: var(--c-paper); padding: 1px 6px; margin-left: 4px; letter-spacing: 0; }
  .card h3 { font-size: 1.375rem; }
  .card h3 a { text-decoration: none; }
  .card h3 a:hover { text-decoration: underline; }
  .score strong { font-size: 2rem; font-variant-numeric: tabular-nums; }
  .sc { border-collapse: collapse; width: 100%; font-size: 0.875rem; }
  .sc th, .sc td { border-bottom: var(--border); padding: 6px 0; text-align: left; font-weight: 400; }
  .sc td { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
  .pc { list-style: none; padding: 0; display: grid; gap: var(--s-2); font-size: 0.9375rem; }
  .pc li { padding-left: 1.4em; position: relative; }
  .pc .pro::before { content: '+'; position: absolute; left: 0; color: var(--c-burgundy); font-weight: 700; }
  .pc .con::before { content: '−'; position: absolute; left: 0; color: var(--c-ink-soft); font-weight: 700; }
  @media (max-width: 900px) { .area__cards { grid-template-columns: 1fr; } }
</style>
