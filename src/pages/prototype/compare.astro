---
/* A/B 나란히 보기: 같은 화면 크기의 iframe 두 개 (iframe 안에서는 프로토타입 바 숨김) */
import Base from '../../layouts/Base.astro';
const areas = [
  { id: 'hero', title: '① Hero Motion', a: '/prototype/hero-a/', b: '/prototype/hero-b/', an: 'Typography × Texture', bn: 'Floating Product' },
  { id: 'transition', title: '② Section Transition', a: '/prototype/transition-a/', b: '/prototype/transition-b/', an: 'Texture Zoom', bn: 'Layered Scroll' },
  { id: 'product', title: '③ Product Interaction', a: '/prototype/product-a/', b: '/prototype/product-b/', an: 'Interactive Gallery', bn: 'Motion Showcase' },
];
---
<Base title="A/B 나란히 비교 | MORH 프로토타입" description="세 영역의 A/B안을 같은 화면 크기로 나란히 비교합니다." header={false} footer={false}>
  <div class="cmp wrap">
    <header class="cmp__head">
      <a href="/prototype/">← 비교 허브</a>
      <h1>A/B 나란히 비교</h1>
      <div class="cmp__ctl" role="group" aria-label="화면 크기">
        <button type="button" data-dev="desktop" aria-pressed="true">데스크톱 1280×800</button>
        <button type="button" data-dev="mobile" aria-pressed="false">모바일 390×844</button>
      </div>
      <p class="muted">각 화면 안에서 직접 스크롤·클릭할 수 있습니다. 두 화면은 같은 크기·같은 이미지·같은 문구를 사용합니다.</p>
    </header>
    {areas.map((ar) => (
      <section class="cmp__area" aria-labelledby={`h-${ar.id}`}>
        <h2 id={`h-${ar.id}`}>{ar.title}</h2>
        <div class="cmp__pair">
          {[['A', ar.a, ar.an], ['B', ar.b, ar.bn]].map(([v, src, n]) => (
            <figure class="cmp__frame">
              <figcaption><strong>{v}안</strong> {n} · <a href={src}>새 창에서 열기</a></figcaption>
              <div class="cmp__viewport"><iframe src={`${src}?embed=1`} title={`${ar.title} ${v}안 ${n}`} loading="lazy"></iframe></div>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .cmp { padding-block: var(--s-6) var(--s-9); }
  .cmp__head { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
  .cmp__head h1 { font-size: var(--fs-h2); }
  .cmp__ctl { display: flex; gap: var(--s-2); }
  .cmp__ctl button { min-height: 44px; padding: 0 var(--s-4); border: var(--border-strong); background: none; cursor: pointer; }
  .cmp__ctl button[aria-pressed='true'] { background: var(--c-ink); color: var(--c-paper); }
  .cmp__area { margin-top: var(--s-7); }
  .cmp__area h2 { font-size: var(--fs-h3); margin-bottom: var(--s-3); }
  .cmp__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .cmp__frame { margin: 0; }
  .cmp__frame figcaption { font-size: var(--fs-small); margin-bottom: var(--s-2); }
  /* 1280×800 화면을 칸 폭에 맞게 축소 */
  .cmp__viewport { --w: 1280; --h: 800; position: relative; width: 100%; aspect-ratio: var(--w) / var(--h); overflow: hidden; border: var(--border-strong); }
  .cmp__viewport iframe { position: absolute; top: 0; left: 0; width: calc(var(--w) * 1px); height: calc(var(--h) * 1px); border: 0; transform-origin: 0 0; transform: scale(var(--k, 0.45)); }
  .is-mobile .cmp__viewport { --w: 390; --h: 844; max-width: 390px; margin-inline: auto; }
  @media (max-width: 900px) { .cmp__pair { grid-template-columns: 1fr; } }
</style>

<script>
  // iframe 을 칸 폭에 맞게 축소
  const fit = () => document.querySelectorAll<HTMLElement>('.cmp__viewport').forEach((v) => {
    const w = document.body.classList.contains('is-mobile') ? 390 : 1280;
    v.style.setProperty('--k', String(v.clientWidth / w));
  });
  new ResizeObserver(fit).observe(document.body);
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-dev]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.body.classList.toggle('is-mobile', b.dataset.dev === 'mobile');
    fit();
    // 화면 크기를 바꾸면 iframe 을 다시 불러와 해당 폭의 레이아웃으로 렌더링
    document.querySelectorAll('iframe').forEach((f) => { f.src = f.src; });
  }));
</script>
