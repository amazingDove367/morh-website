---
/* 공통 디자인 시스템 초안 v0.1 — 토큰을 실제 CSS 변수로 렌더링 */
import Base from '../../layouts/Base.astro';
const colors = [
  ['--c-paper', '#FCFAF6', '기본 배경. 텍스처의 흰 배경과 이어짐'],
  ['--c-ivory', '#F4EEE4', '보조 면 · 뚜껑/몸체 아이보리'],
  ['--c-cream', '#EDE3D8', '몸체 크림 (사진 실측)'],
  ['--c-cream-tex', '#F2EFE9', '텍스처 → 섹션 배경 연결색'],
  ['--c-burgundy', '#630225', '로고 버건디 (사진 실측) · 주요 버튼·강조'],
  ['--c-ink', '#2B1A1F', '본문 텍스트'],
  ['--c-ink-soft', '#5E4A50', '보조 텍스트'],
  ['--c-gold', '#D6B994', '골드 경계 (사진 실측) · 선·작은 디테일 전용'],
];
const type = [
  ['Display · 홈 히어로', 'var(--fs-display)', 700, 'var(--f-sans)', '한 겹 더 가리지 않아도,'],
  ['H1', 'var(--fs-h1)', 650, 'var(--f-sans)', '모르 브라이트닝 크림'],
  ['H2', 'var(--fs-h2)', 650, 'var(--f-sans)', '유행보다 핵심에 집중한 미백 크림.'],
  ['Accent · 세리프 이탤릭', 'var(--fs-h2)', 500, 'var(--f-serif)', 'MORH · Brightening Cream'],
  ['Body 17/16px', 'var(--fs-body)', 400, 'var(--f-sans)', '아침·저녁 스킨케어 마지막 단계에 적당량을 펴 바릅니다.'],
];
const motion = [
  ['--ease-cream', 'cubic-bezier(.22,.61,.36,1)', '기본. 크림이 퍼지듯 빠르게 시작해 천천히 멈춤'],
  ['--ease-inout', 'cubic-bezier(.65,0,.35,1)', '장면 전환·떠 있는 움직임'],
  ['--dur-ui', '180ms', '버튼·탭·포커스'],
  ['--dur-panel', '320ms', '시트·갤러리 사진 전환'],
  ['--dur-reveal', '900ms', '섹션 요소 등장 (한 번만)'],
  ['--dur-hero', '1200ms', '첫 화면 연출. 콘텐츠는 처음부터 보임'],
];
---
<Base title="디자인 시스템 초안 | MORH 프로토타입" description="MORH 홈과 상세페이지가 공유하는 디자인 토큰 초안입니다.">
  <div class="ds wrap">
    <p class="label">Design System · Draft v0.1</p>
    <h1>공통 디자인 시스템 초안</h1>
    <p class="muted lead">홈은 같은 토큰을 크게·자유롭게, 상세페이지는 같은 토큰을 그리드와 얇은 선 안에서 정돈해 사용합니다.</p>

    <section aria-labelledby="ds-color">
      <h2 id="ds-color">색상</h2>
      <p class="muted">용기 사진에서 직접 측정한 로고·뚜껑·몸체·골드 경계 색을 기준으로 했습니다. 골드는 선과 작은 디테일에만 씁니다.</p>
      <ul role="list" class="sw">
        {colors.map(([v, hex, note]) => (
          <li><span class="sw__chip" style={`background:var(${v})`}></span><code>{v}</code><strong>{hex}</strong><span class="muted">{note}</span></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="ds-type">
      <h2 id="ds-type">타이포그래피</h2>
      <p class="muted">Pretendard(한글·본문, OFL) + Cormorant Garamond(로고 인상과 맞는 세리프 강조, OFL). 두 서체만 자체 호스팅하며 외부 폰트 요청은 없습니다.</p>
      <dl class="ty">
        {type.map(([n, fs, fw, ff, s]) => (
          <div><dt class="label">{n}</dt><dd style={`font-size:${fs};font-weight:${fw};font-family:${ff};line-height:1.15;letter-spacing:${String(ff).includes('sans') && fw === 700 ? 'var(--ls-display)' : 'var(--ls-head)'}`}>{s}</dd></div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="ds-ui">
      <h2 id="ds-ui">버튼 · 내비게이션 · 정보 구획</h2>
      <div class="ui">
        <a class="btn" href="#ds-ui">제품 자세히 보기 <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#ds-ui">보조 버튼</a>
        <span class="test-tag test-tag--sample"></span><span class="test-tag test-tag--plan"></span><span class="test-tag test-tag--tbd"></span>
      </div>
      <p class="muted">버튼은 모서리 없는 직사각형, 높이 52px(터치 44px 이상). 상세페이지 정보는 1px 선으로 구획합니다.</p>
    </section>

    <section aria-labelledby="ds-grid">
      <h2 id="ds-grid">그리드와 간격</h2>
      <div class="grid-demo" aria-hidden="true">{Array.from({ length: 12 }, () => <span></span>)}</div>
      <p class="muted">12단 그리드 · 최대 폭 1440px · 좌우 여백 16px(모바일)~48px · 단 간격 16~24px · 간격 단위 4·8·12·16·24·32·48·64·96·144px. 반응형 기준: 720px(모바일), 900px(상세 2단 → 1단).</p>
    </section>

    <section aria-labelledby="ds-motion">
      <h2 id="ds-motion">모션 원칙</h2>
      <table class="mt">
        <tbody>{motion.map(([k, v, n]) => <tr><th scope="row"><code>{k}</code></th><td>{v}</td><td class="muted">{n}</td></tr>)}</tbody>
      </table>
      <ul class="rules">
        <li>스크롤을 가로채거나 속도를 바꾸지 않습니다. 현재 스크롤 위치를 읽어 transform·opacity만 바꿉니다.</li>
        <li>고정 구간은 최대 약 2화면. 진입을 막는 로딩 연출 없음. 핵심 문구는 애니메이션 없이도 처음부터 보입니다.</li>
        <li>같은 등장 효과를 모든 섹션에 반복하지 않습니다(히어로: 펴 바르듯 드러남 / 전환: 확대 또는 층 이동 / 상세: 사진 교체만).</li>
        <li>움직임 줄이기 설정 시 고정 구간과 연속 모션을 끄고 정지 레이아웃으로 바꿉니다(?motion=off 로 미리보기).</li>
        <li>상세페이지 구매 정보 영역에는 모션을 적용하지 않습니다.</li>
        <li>정지 사진 5장은 '사진 전환'으로만 보여 주며 360도 회전처럼 연출하지 않습니다.</li>
      </ul>
    </section>

    <section aria-labelledby="ds-photo">
      <h2 id="ds-photo">제품 사진 · 텍스처 표현</h2>
      <ul class="rules">
        <li>용기 사진은 비율·색·로고를 바꾸지 않고 contain으로 배치합니다. 웹용 파생본은 가장자리만 0.6px 안티앨리어싱 처리했습니다.</li>
        <li>크림 텍스처(420×560px)는 multiply로 종이색에 겹쳐 흰 배경 이음새를 없앱니다. 반복 타일링은 하지 않습니다.</li>
        <li>텍스처 표시 폭은 최대 400px. 확대 연출은 매끈한 지점으로 들어가며 후반부를 같은 톤의 면으로 덮어 흐림이 드러나지 않게 합니다.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .ds { padding-block: var(--s-7) var(--s-9); display: grid; gap: var(--s-8); }
  .ds > h1 { font-size: var(--fs-h1); margin-top: calc(-1 * var(--s-7)); }
  .ds > .lead { margin-top: calc(-1 * var(--s-7)); max-width: 60ch; }
  .ds section { display: grid; gap: var(--s-4); border-top: var(--border-strong); padding-top: var(--s-5); }
  .ds h2 { font-size: var(--fs-h3); }
  .sw { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--s-4); }
  .sw li { display: grid; gap: 2px; font-size: 0.875rem; }
  .sw__chip { height: 72px; border: var(--border); margin-bottom: var(--s-2); }
  .ty div { border-bottom: var(--border); padding: var(--s-4) 0; display: grid; gap: var(--s-2); }
  .ty dd { margin: 0; overflow-wrap: anywhere; }
  .ui { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; }
  .grid-demo { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--col-gap); height: 64px; }
  .grid-demo span { background: color-mix(in srgb, var(--c-burgundy) 12%, transparent); }
  .mt { border-collapse: collapse; width: 100%; font-size: 0.9375rem; }
  .mt th, .mt td { text-align: left; padding: var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: var(--border); }
  .rules { display: grid; gap: var(--s-2); padding-left: 1.2em; max-width: 72ch; }
  @media (max-width: 720px) { .mt td.muted { display: none; } }
</style>
