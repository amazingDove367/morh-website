---
/*
  주문/결제 화면
  - 주문 상품(수량) · 배송 지역 · 결제 금액(상품 금액·첫 구매 혜택·배송비·총액) → '결제하기'
  - '결제하기'(핵심 전환)를 누르면 바로 완료 화면으로 이동 — 개인정보를 받지 않음
  - 개인정보가 아닌 주문 내역(수량·지역·금액)만 sessionStorage 로 완료 화면에 전달
*/
import Base from '../../../layouts/Base.astro';
import { PRICE, SHIPPING, PRODUCT, orderSummary } from '../../../data/commerce';
import { viewImg } from '../../../data/product';
import { localePath, localeStaticPaths, withBase, type Locale } from '../../../i18n/locales';
import { DICTS, money } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = DICTS[locale];
const c = t.checkout;
const s = orderSummary(1, 'standard');
---
<Base pageType="checkout" locale={locale} path="/checkout/" title={t.meta.checkoutTitle} description={t.meta.checkoutDesc} noindex>
  <div class="co wrap" data-checkout data-locale={locale} data-complete={localePath(locale, '/checkout/complete/')}
       data-base={PRICE.base} data-first={PRICE.firstPurchase} data-ship={SHIPPING.standard} data-remote={SHIPPING.remoteTotal}
       data-max={PRODUCT.maxQty}>
    <h1 class="co__title">{c.title}</h1>

    <div class="co__grid">
      <div class="co__main">
        <section class="co__box" aria-labelledby="co-item">
          <h2 id="co-item">{c.item}</h2>
          <div class="co__item">
            <img src={withBase(viewImg('front', 'thumb'))} width="160" height="160" alt="" />
            <div class="co__item-text">
              <p class="co__name">{t.common.product}</p>
              <p class="muted">{t.common.volume}</p>
              <p class="co__prices"><s>{money(locale, PRICE.base)}</s> <strong>{money(locale, PRICE.firstPurchase)}</strong> <span class="co__first">{t.product.firstPrice}</span></p>
            </div>
            <div class="qty" role="group" aria-label={t.product.qty}>
              <button type="button" class="qty__btn" data-co-qty="-1" aria-label={t.product.qtyDec}>−</button>
              <output class="qty__val" data-co-qty-value aria-live="polite">1</output>
              <button type="button" class="qty__btn" data-co-qty="1" aria-label={t.product.qtyInc}>+</button>
            </div>
          </div>
        </section>

        <section class="co__box" aria-labelledby="co-region">
          <h2 id="co-region">{c.region}</h2>
          <fieldset class="co__region">
            <legend class="visually-hidden">{c.region}</legend>
            <label class="co__radio"><input type="radio" name="region" value="standard" checked data-region /> <span>{c.regionStandard} · {money(locale, SHIPPING.standard)}</span></label>
            <label class="co__radio"><input type="radio" name="region" value="remote" data-region /> <span>{c.regionRemote} · {money(locale, SHIPPING.remoteTotal)}</span></label>
            <p class="co__hint">{c.regionHint}</p>
          </fieldset>
        </section>
      </div>

      <aside class="co__side" aria-labelledby="co-sum">
        <section class="co__box co__summary">
          <h2 id="co-sum">{c.summary}</h2>
          <dl>
            <div><dt>{c.subtotal}</dt><dd data-sum="subtotal">{money(locale, s.subtotal)}</dd></div>
            <div><dt>{c.benefit}</dt><dd class="co__minus" data-sum="benefit">−{money(locale, s.benefit)}</dd></div>
            <div><dt>{c.shipping}</dt><dd data-sum="shipping">{money(locale, s.shipping)}</dd></div>
            <div class="co__total"><dt>{c.total}</dt><dd data-sum="total">{money(locale, s.total)}</dd></div>
          </dl>
          <button type="button" class="btn btn--block co__pay" id="cta-pay">{c.pay}</button>
          <a class="text-link co__back" href={localePath(locale, '/product/')} data-ga="cta_click" data-ga-cta-location="checkout_back"><span class="arrow flip-back" aria-hidden="true">←</span> {c.back}</a>
        </section>
      </aside>
    </div>
  </div>

</Base>

<style>
  .co { padding-block: var(--s-6) var(--s-8); display: grid; gap: var(--s-4); }
  .co__title { font-size: var(--fs-h2); }
  .co__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--s-6); align-items: start; margin-top: var(--s-2); }
  .co__main { display: grid; gap: var(--s-5); }
  .co__box { border: 1px solid var(--c-line-strong); padding: 20px; display: grid; gap: var(--s-4); }
  .co__box h2 { font-size: 0.8125rem; letter-spacing: 0.06em; font-weight: 700; }
  .co__item { display: grid; grid-template-columns: 80px 1fr auto; gap: var(--s-4); align-items: center; }
  .co__item img { width: 80px; height: 80px; object-fit: contain; background: #fff; }
  .co__name { font-weight: 650; }
  .co__prices { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; margin-top: 4px; font-size: 0.875rem; }
  .co__prices s { color: var(--c-ink-soft); }
  .co__first { color: var(--c-burgundy); font-size: 0.75rem; font-weight: 600; }
  .qty { display: inline-flex; align-items: center; border: 1px solid var(--c-line-strong); }
  .qty__btn { width: 40px; height: 40px; border: 0; background: none; cursor: pointer; font-size: 1.125rem; }
  .qty__btn[disabled] { opacity: 0.35; cursor: not-allowed; }
  .qty__val { min-width: 2em; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: var(--s-3); }
  legend { font-weight: 600; font-size: 0.875rem; margin-bottom: var(--s-2); }
  .co__radio { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
  .co__radio input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--c-burgundy); flex: none; }
  .co__hint { font-size: 0.8125rem; color: var(--c-ink-soft); }
  .co__side { position: sticky; top: calc(var(--header-h) + 24px); }
  .co__summary dl { display: grid; gap: 8px; font-size: 0.9375rem; }
  .co__summary dl div { display: flex; justify-content: space-between; gap: var(--s-3); }
  .co__summary dd { font-variant-numeric: tabular-nums; }
  .co__minus { color: var(--c-burgundy); }
  .co__total { border-top: 1px solid var(--c-line-strong); padding-top: 10px; margin-top: 4px; font-weight: 700; font-size: 1.0625rem; }
  .co__pay { margin-top: var(--s-2); min-height: 56px; font-size: 1rem; }
  .co__back { justify-self: start; font-size: 0.875rem; }
  :global([dir='rtl']) .flip-back { transform: scaleX(-1); display: inline-block; }
  @media (max-width: 900px) {
    .co__grid { grid-template-columns: 1fr; }
    .co__side { position: static; }
    .co__item { grid-template-columns: 64px 1fr; }
    .co__item img { width: 64px; height: 64px; }
    .co__item .qty { grid-column: 1 / -1; justify-self: start; }
  }
</style>

<script>
  import { initCheckout } from '../../../scripts/checkout';
  initCheckout();
</script>
